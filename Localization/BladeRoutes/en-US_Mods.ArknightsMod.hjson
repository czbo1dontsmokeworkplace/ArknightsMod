BranchTraits: {
	Swordmaster: Swordmaster:  Hits cause an additional cutting effect
	Lord: Lord:  Allows ranged projectile attacks
}

Items: {
	CutterBlades: {
		DisplayName: Blades [Cutter]
		Tooltip:
			'''
			Slash with the blade; hits trigger an additional cut
			Swings release one straight Terra Blade-style beam
			'''
	}

	BibeakSword: {
		DisplayName: Feather Sword [Bibeak]
		Tooltip:
			'''
			Slash with the blade; hits trigger an additional cut
			Swings release one straight Terra Blade-style beam
			'''
	}

	IreneSaber: {
		DisplayName: Inquisitor Saber [Irene]
		Tooltip:
			'''
			Slash with the blade; hits trigger an additional cut
			Swings release one straight Terra Blade-style beam
			'''
	}

	MidnightSword: {
		DisplayName: Nightfall Sword [Midnight]
		Tooltip:
			'''
			Swing with a dark Thorns-style arc and release an ink blade once per second
			Ink blades accelerate straight through walls and enemies, hitting each enemy once
			'''
	}

	AreneSword: {
		DisplayName: Mechanical Sword [Arene]
		Tooltip:
			'''
			Swing the blade to release plasma clusters
			Clusters pierce indefinitely and fire once per second
			'''
	}

	LapplandSwords: {
		DisplayName: Wolfspirit Swords [Lappland]
		Tooltip:
			'''
			White Thorns-style sword arcs release a small Nox-style light bolt
			Fires once per second with infinite piercing and continuous acceleration
			The bolt flies straight without homing
			'''
	}
}

Projectiles.LapplandNoxShard.DisplayName: Wolfspirit Light Bolt
