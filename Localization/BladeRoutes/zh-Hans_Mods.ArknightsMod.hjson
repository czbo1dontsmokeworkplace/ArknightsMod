BranchTraits: {
	Swordmaster: 剑豪：  命中敌人时造成额外的切割效果
	Lord: 领主：  允许进行远程弹幕攻击
}

Items: {
	CutterBlades: {
		DisplayName: 双刃 [刻刀]
		Tooltip:
			'''
			挥动剑刃，命中时追加斩击
			挥剑发出一道直行刀光
			'''
	}

	BibeakSword: {
		DisplayName: 羽剑 [柏喙]
		Tooltip:
			'''
			挥动剑刃，命中时追加斩击
			挥剑发出一道直行刀光
			'''
	}

	IreneSaber: {
		DisplayName: 审判佩剑 [艾丽妮]
		Tooltip:
			'''
			挥动剑刃，命中时追加斩击
			挥剑发出一道直行刀光
			'''
	}

	MidnightSword: {
		DisplayName: 夜色长剑 [月见夜]
		Tooltip:
			'''
			挥出暗色棘刺式刀光，每秒释放一道黑夜暗刃
			暗刃穿墙、无限贯穿，沿直线逐渐加速；同一敌人只命中一次
			'''
	}

	AreneSword: {
		DisplayName: 机巧剑 [芳汀]
		Tooltip:
			'''
			挥动剑刃，释放等离子簇
			等离子簇无限贯穿，每秒发射一次
			'''
	}

	LapplandSwords: {
		DisplayName: 狼魂双剑 [拉普兰德]
		Tooltip:
			'''
			挥出白色棘刺式刀光，释放诺克斯式小型光弹
			每秒发射一次，无限贯穿并持续加速
			光弹沿直线飞行，不会追踪目标
			'''
	}
}

