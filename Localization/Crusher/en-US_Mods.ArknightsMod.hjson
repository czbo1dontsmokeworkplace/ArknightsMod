Items: {
	QuartzGreatsword: {
		DisplayName: Quartz's Greatsword
		Tooltip:
			'''
			Hold left click to charge, then release a single custom swing; fully charges in 1 second before attack-speed modifiers
			Charge increases damage from 100% to 300%, gradually grows the weapon from its original size to 1.5x, and strengthens the outline and slash effects
			A shared head bar shows charge; a crystal chime signals full charge
			Only fully charged physical blade hits call a piercing golden crystal from below that homes in on the struck enemy
			'''
	}

	WindChimesHeavyBlade: {
		DisplayName: Wind Chimes' Heavy Blade
		Tooltip:
			'''
			Hold left click to charge, then release a single custom swing; fully charges in 1 second before attack-speed modifiers
			Charge increases damage from 100% to 300%, gradually grows the weapon from its original size to 1.5x, and strengthens the outline and slash effects
			A shared head bar shows charge; a crystal chime signals full charge
			Only fully charged physical blade hits call two rising wind blades from below that home in on the struck enemy
			'''
	}

	HoedererGreatsword: {
		DisplayName: Hoederer's Greatsword
		Tooltip:
			'''
			Hold left click to charge, then release a single custom swing; fully charges in 1 second before attack-speed modifiers
			Charge increases damage from 100% to 300%, gradually grows the weapon from its original size to 1.5x, and strengthens the outline and slash effects
			A shared head bar shows charge; a crystal chime signals full charge
			Only fully charged physical blade hits erupt into three piercing flames from below that home in on the struck enemy
			Deals 20% increased damage to stunned enemies
			'''
	}

	UlpianusAnchor: {
		DisplayName: Ulpianus's Anchor
		Tooltip:
			'''
			Hold left click to charge, then release to swing the anchor; fully charges in 1 second before attack-speed modifiers
			Charge increases damage from 100% to 300% and gradually grows the weapon from its original size to 1.5x
			A shared head bar shows charge; a crystal chime signals full charge
			Only a fully charged first-skill attack at full SP throws the anchor; normal attacks and skills 2 and 3 swing it
			Thrown anchors coast, fall under gravity, then return along their chain; only one may be in flight
			Each new enemy struck directly triggers a 150x150 arcane blast, dealing one extra hit for 100% of the thrown anchor's melee damage
			Ground impacts after 10 ticks deal 60% splash damage without hitting the same enemy twice
			Only fully charged direct swing or thrown-anchor hits call a heavy anchor from below that homes in on the struck enemy with unlimited piercing
			'''
	}
}

Skills: {
	QuartzGreatsword: {
		1: {
			Label: ATK Up β
			Desc: Gain 20%-80% attack damage for 25 seconds, scaling with skill level.
		}

		2: {
			Label: All-Out Effort
			Desc: For 20 seconds, gain 35%-80% attack speed and deal 80%-120% damage per hit, but take 25% more damage. Each target has a 25% chance to be stunned for 2 seconds. Bosses and enemies immune to knockback resist this stun.
		}
	}

	WindChimesHeavyBlade: {
		1: {
			Label: ATK Up γ
			Desc: Gain 30%-100% attack damage for 30 seconds, scaling with skill level.
		}

		2: {
			Label: Unchanging Homeland
			Desc: Stop normal attacks and prepare for 5 seconds with 20%-35% damage reduction. Release a heavy aimed cut for 140%-300% damage, increasing by another 50% at full charge, and stun ordinary knockback-vulnerable enemies for 1 second. Press the skill key again to release early.
		}
	}

	HoedererGreatsword: {
		1: {
			Label: Unquenchable Edge
			Desc: Recover SP by attacking. At full SP, the next sweep deals 160%-260% damage and its first valid hit heals 10%-25% of maximum life. Group hits heal only once per swing.
		}

		2: {
			Label: Ember's Burden
			Desc: While selected, gain 4%-40% attack damage. Activate to increase attack interval by 20% and stun ordinary knockback-vulnerable enemies for 1 second on a hit. Press again to end; switching weapons or skills also ends it.
		}

		3: {
			Label: Dying Smoke
			Desc: For 70 seconds, gain 20% reach, 15%-60% maximum life and 30%-120% attack damage. Lose 1% maximum life each second; the first valid hit per swing heals 5% maximum life. Enemies you contact take 20-40 damage per second until the skill ends. Hits have a 25% chance to stun ordinary knockback-vulnerable enemies for 2-5 seconds.
		}
	}

	UlpianusAnchor: {
		1: {
			Label: Contact That Must Be Made
			Desc: Recover SP over time. At full SP, the next fully charged attack throws the anchor. A direct hit calls an anchor from below that homes in on the struck enemy, dealing 170%-270% damage with unlimited piercing and dragging the first two ordinary knockback-vulnerable enemies toward you.
		}

		2: {
			Label: Boundary That Must Be Maintained
			Desc: Automatically activates at full SP: swing the anchor to attack, gain 100%-160% attack damage, 20%-60% maximum life and an extra 2-4 life regeneration per second (also increased by 30% by the Crusher trait). Lasts until switching weapons or skills or dying. Maximum-life increases do not heal.
		}

		3: {
			Label: Path That Must Be Opened
			Desc: For 25 seconds, swing the anchor to attack and gain 170%-260% attack damage and 20%-80% maximum life. Direct swing hits stun ordinary knockback-vulnerable enemies for 5 seconds. Press again to end early.
		}
	}
}

