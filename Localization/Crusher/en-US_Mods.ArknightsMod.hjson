Items: {
	QuartzGreatsword: {
		DisplayName: Greatsword [Quartz]
		Tooltip:
			'''
			Hold left click to charge, then release a single custom swing; fully charges in 1 second before attack-speed modifiers
			Charge increases damage from 100% to 300%, gradually grows the weapon from its original size to 1.5x, and strengthens the outline and slash effects
			A shared head bar shows charge; a crystal chime signals full charge
			Only fully charged physical blade hits call a piercing golden crystal from below that homes in on the struck enemy
			'''
	}

	WindChimesHeavyBlade: {
		DisplayName: Heavy Blade [Wind Chimes]
		Tooltip:
			'''
			Hold left click to charge, then release a single custom swing; fully charges in 1 second before attack-speed modifiers
			Charge increases damage from 100% to 300%, gradually grows the weapon from its original size to 1.5x, and strengthens the outline and slash effects
			A shared head bar shows charge; a crystal chime signals full charge
			Only fully charged physical blade hits call two rising wind blades from below that home in on the struck enemy
			'''
	}

	HoedererGreatsword: {
		DisplayName: Greatsword [Hoederer]
		Tooltip:
			'''
			Hold left click to charge, then release a single custom swing; fully charges in 1 second before attack-speed modifiers
			Charge increases damage from 100% to 300%, gradually grows the weapon from its original size to 1.5x, and strengthens the outline and slash effects
			A shared head bar shows charge; a crystal chime signals full charge
			Only fully charged physical blade hits erupt into three piercing flames from below that home in on the struck enemy
			Deals 20% increased damage to stunned enemies
			'''
	}

	UlpianusAnchor: {
		DisplayName: Anchor [Ulpianus]
		Tooltip:
			'''
			Hold left click to charge, then release to swing the anchor; fully charges in 1 second before attack-speed modifiers
			Charge increases damage from 100% to 300% and gradually grows the weapon from its original size to 1.5x
			A shared head bar shows charge; a crystal chime signals full charge
			Only a fully charged first-skill attack at full SP throws the anchor; normal attacks and skills 2 and 3 swing it
			Thrown anchors coast, fall under gravity, then return along their chain; only one may be in flight
			Each new enemy struck directly triggers a 150x150 arcane blast, dealing one extra hit for 100% of the thrown anchor's melee damage
			Ground impacts after 10 ticks deal 60% splash damage without hitting the same enemy twice
			Only fully charged direct swing or thrown-anchor hits call a heavy anchor from below that homes in on the struck enemy with unlimited piercing
			'''
	}
}

