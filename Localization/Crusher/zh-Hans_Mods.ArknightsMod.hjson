Items: {
	QuartzGreatsword: {
		DisplayName: 重剑 [石英]
		Tooltip:
			'''
			按住左键蓄力，松开挥出一刀；基础1秒蓄满，受攻速影响
			伤害随蓄力从100%提高至300%，武器从原大小逐渐增至1.5倍，描边与斩击特效逐渐增强
			头顶显示蓄力条，蓄满时响起水晶提示音
			只有满蓄力的实体斩击命中敌人时，从下方唤起一道追踪被斩中敌人的贯穿金晶
			'''
	}

	WindChimesHeavyBlade: {
		DisplayName: 重刀 [铎铃]
		Tooltip:
			'''
			按住左键蓄力，松开挥出一刀；基础1秒蓄满，受攻速影响
			伤害随蓄力从100%提高至300%，武器从原大小逐渐增至1.5倍，描边与斩击特效逐渐增强
			头顶显示蓄力条，蓄满时响起水晶提示音
			只有满蓄力的实体斩击命中敌人时，从下方唤起两道追踪被斩中敌人的逆卷风刃
			'''
	}

	HoedererGreatsword: {
		DisplayName: 重剑 [赫德雷]
		Tooltip:
			'''
			按住左键蓄力，松开挥出一刀；基础1秒蓄满，受攻速影响
			伤害随蓄力从100%提高至300%，武器从原大小逐渐增至1.5倍，描边与斩击特效逐渐增强
			头顶显示蓄力条，蓄满时响起水晶提示音
			只有满蓄力的实体斩击命中敌人时，从下方连续喷发三道追踪被斩中敌人的贯穿赤焰
			对已眩晕的敌人造成的伤害提高20%
			'''
	}

	UlpianusAnchor: {
		DisplayName: 船锚 [乌尔比安]
		Tooltip:
			'''
			按住左键蓄力，松开挥动船锚；基础1秒蓄满，受攻速影响
			伤害随蓄力从100%提高至300%，武器随蓄力从原大小逐渐增至1.5倍
			头顶显示蓄力条，蓄满时响起水晶提示音
			仅一技能技力充满后的满蓄力攻击抛出船锚，普攻及二、三技能均为挥动
			投出的船锚先直飞再下坠，砸地后沿锁链收回；同时只能投出一枚
			船锚每次直接命中新敌人时，引发150×150法术冲爆，额外造成一次船锚100%的近战伤害
			飞行10帧后砸地产生60%伤害的范围冲击，同一目标不会重复受击
			只有满蓄力的挥击或投锚直接命中敌人时，重锚从下方冲起并追踪该敌人，无限贯穿
			'''
	}
}

