Projectiles.ReaperWisp.DisplayName: 收割流光

Skills: {
	HumusScythe: {
		1: {
			Label: 固废切割
			Desc: 近战命中回复技力。充满后下一轮攻击造成160%～260%伤害，且本轮左键吸血量翻倍。月牙与右键旋转不能吸血。
		}

		2: {
			Label: 高效处理
			Desc: 持续30秒。生命高于50%时攻击力提高21%～50%，高于80%时此加成翻倍。
		}
	}

	LaPlumaScythe: {
		1: {
			Label: 高速切割
			Desc: 近战命中回复技力。充满后下一轮攻击造成130%～165%伤害。月牙与右键旋转不能吸血。
		}

		2: {
			Label: 收割
			Desc: 持续25秒，攻击速度提高50%～100%，攻击力提高10%～50%；近战命中半血以下的敌人时，额外造成30%伤害。
		}
	}
}
