Items: {
	MagallanController: {
		DisplayName: Magallan's Soaring Dragon Controller
		Tooltip:
			'''
			Summons a “Soaring Dragon” drone to fight alongside you
			The drone always follows you in flight
			It equips a different module for each skill
			'''
		CurrentModule: Current module: “{0}”
	}
}

Skills: {
	MagallanController: {
		1: {
			Label: High-Efficiency Freezing Module
			Desc:
				'''
				Drones continuously release cold mist that damages and slows nearby ordinary enemies
				The mist briefly binds enemies; this mode stays active
				'''
		}

		2: {
			Label: Laser Mining Module
			Desc:
				'''
				Drones target enemies within 15 tiles and continuously fire lasers
				Lasers reach up to 15 tiles and pierce every enemy in their path, but stop at terrain; this mode stays active
				'''
		}

		3: {
			Label: Armed Combat Module
			Desc:
				'''
				Drones target enemies within 150 tiles and launch missiles straight down
				Missiles pass through terrain, fly straight briefly, then turn toward their target with increasing agility
				Each missile explodes once, damaging enemies in a 75 by 75 area
				This mode stays active
				'''
		}
	}
}

Projectiles: {
	MagallanDrone.DisplayName: Soaring Dragon
	MagallanColdPulse.DisplayName: Cooling Pulse
	MagallanLaser.DisplayName: Mining Laser
	MagallanShell.DisplayName: Soaring Dragon Shell
	MagallanExplosion.DisplayName: Soaring Dragon Explosion
}

