Skills: {
	MagallanController: {
		1: {
			Label: 高效制冷模块
			Desc:
				'''
				无人机持续释放寒雾，伤害并减缓附近的普通敌人
				寒雾会短暂束缚敌人；此模式始终生效
				'''
		}

		2: {
			Label: 激光开采模块
			Desc:
				'''
				无人机锁定19.5格内的敌人，连续发射瞬时绿色激光
				激光从无人机直接连接至锁定目标，每道只命中该目标一次；此模式始终生效
				'''
		}

		3: {
			Label: 武装打击模块
			Desc:
				'''
				无人机锁定120格内的敌人，向下发射导弹
				导弹可穿过地形，先直飞片刻，再逐渐转向追踪敌人
				导弹爆炸时对75×75范围内的敌人造成一次伤害
				此模式始终生效
				'''
		}
	}
}

