Skills: {
	MagallanController: {
		1: {
			Label: 高效制冷模块
			Desc:
				'''
				无人机持续释放寒雾，伤害并减缓附近的普通敌人
				寒雾会短暂束缚敌人；此模式始终生效
				'''
		}

		2: {
			Label: 激光开采模块
			Desc:
				'''
				无人机锁定15格内的敌人，持续发射激光
				激光最长延伸15格，可贯穿沿途所有敌人，但会被地形阻挡；此模式始终生效
				'''
		}

		3: {
			Label: 武装打击模块
			Desc:
				'''
				无人机锁定150格内的敌人，向下发射导弹
				导弹可穿过地形，先直飞片刻，再逐渐转向追踪敌人
				导弹爆炸时对75×75范围内的敌人造成一次伤害
				此模式始终生效
				'''
		}
	}
}

