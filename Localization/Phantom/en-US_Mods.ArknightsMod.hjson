Items: {
	PhantomDaggers: {
		DisplayName: Phantom's Mirror Blades
		Tooltip:
			'''
			Alternate rapid cuts with silver-blue blade trails
			Increases movement and jump speed by 15% while held
			Deploy using the skill key, a dash start, a fast landing, or switching from another hotbar weapon
			Combat teleports while holding the blades also deploy; body redeployment cooldown: 12 seconds
			Right-click to place one stationary phantom for 10 seconds; independent cooldown: 25 seconds
			The phantom has 65% base attack, copies the selected deployment skill, and attacks nearby enemies
			Place within about 14 tiles with clear line of sight; switching away or moving over 32 tiles away dismisses it
			Switching skills or items and dying do not reset cooldowns
			'''
	}
}

Skills: {
	PhantomDaggers: {
		1: {
			Label: Phantom of the Night
			Desc: Deploy for 10 seconds of protection: 20%-50% dodge and a shield worth 20%-80% of maximum life against enemy contact and projectiles. The phantom has a 65%-strength shield and provides backup protection within 15 tiles. Dodge chances do not stack. Body cooldown: 12 seconds; independent phantom cooldown: 25 seconds
		}

		2: {
			Label: Bloody Opus
			Desc: Deploy with 7-10 attack stacks, each adding 10%-20% attack until this deployment ends. Each slash that deals damage consumes at most one stack; misses consume none. Body and phantom have separate stacks. Deployment lasts 10 seconds. Body cooldown: 12 seconds; independent phantom cooldown: 25 seconds
		}

		3: {
			Label: Night Raid
			Desc: Deployment deals 180%-300% physical attack damage and knockback to visible enemies within 8 tiles. Each deployment randomly chooses an 80% slow, bind, or stun lasting 2-4.5 seconds. Bind prevents movement but allows attacks. Bosses and segmented enemies resist control. Body and phantom trigger separately. Body cooldown: 12 seconds; independent phantom cooldown: 25 seconds
		}
	}
}

Projectiles: {
	PhantomHoldout.DisplayName: Phantom's Mirror Blades
	PhantomSlash.DisplayName: Mirror Cut
	PhantomPerformer.DisplayName: Mirror Phantom
	PhantomCurtain.DisplayName: Night Raid
}

