			包含本Boss四把武器中的一把、专属专家饰品和金币；有概率获得面具
			'''
	}

	PompeiiEmblem: {
		DisplayName: 熔壳余温
		Tooltip: 免疫着火，攻击速度提高6%
	}

	PompeiiMask: {
		DisplayName: 庞贝面具
		Tooltip: 可穿戴的纪念面具
	}

