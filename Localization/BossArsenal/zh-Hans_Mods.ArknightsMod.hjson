Items: {
	HarbingerGuillotine: {
		DisplayName: 邪兆裁断
		Tooltip:
			'''
			挥剑射出赤色流光，并召来天降光雨
			命中留下滞留火焰，追踪敌人后爆破
			'''
	}

	CatastropheSalvo: {
		DisplayName: 榴霰弹
		Tooltip: 消耗火箭发射加速炮弹，命中引发大范围爆炸
	}

	ScarletMeson: {
		DisplayName: 猩红介子炮
		Tooltip: 按住左键发射间歇激光，在首个敌人或地形处停止
	}

	UrsusArtilleryLink: {
		DisplayName: 乌萨斯单兵迫击阵地
		Tooltip:
			'''
			召唤唯一的随行迫击炮，以抛物线炮击敌人
			占满仆从栏，伤害随栏位数提升
			'''
	}

	WinterScar: {
		DisplayName: 冬痕
		Tooltip:
			'''
			挥剑释放逐渐加速的寒霜光波
			最多贯穿4名敌人，命中后逐渐淡出
			'''
	}

	YetiSnowGrenade: {
		DisplayName: 雪怪冰弹
		Tooltip: 投掷弹跳冰弹，命中或引信耗尽后引发冰爆
	}

	BlackIceCoffin: {
		DisplayName: 黑冰镇棺
		Tooltip:
			'''
			自动在敌人头顶凝结三枚黑冰，蓄力后下坠
			命中染黑附近方块，接触者每秒失去120点生命
			同样伤害玩家与首领，重叠区域不叠加
			'''
	}

	YetiChime: {
		DisplayName: 雪祀风铃
		Tooltip:
			'''
			召唤唯一的冰霜水晶，占满仆从栏并随栏位增伤
			先释放追踪冰弹，再以激光锁定一个敌人
			'''
	}

	BasaltBreaker: {
		DisplayName: 熔壳碎锋
		Tooltip:
			'''
			挥剑掷出两颗可滚动的陨石，持续3秒
			刀刃直接命中引发火山爆发
			'''
	}

	CalderaBellows: {
		DisplayName: 火山风箱
		Tooltip: 消耗凝胶持续喷射贯穿敌人的烈焰
	}

	CinderTestament: {
		DisplayName: 炼狱余烬录
		Tooltip: 按住左键蓄力，释放固定在原地的贯穿激光
	}

	BasaltBrood: {
		DisplayName: 熔岩育巢
		Tooltip: 召唤熔岩幼体，以冲撞和突刺攻击敌人
	}

	HarbingerRewardBag: {
		DisplayName: 邪魔炮火中枢先兆者宝藏袋
		Tooltip:
			'''
			右键打开
			包含本Boss四把武器中的一把、专属专家饰品和金币；有概率获得面具
			'''
	}

	HarbingerEmblem: {
		DisplayName: 炮火校准芯
		Tooltip: 远程与魔法伤害提高8%
	}

	HarbingerMask: {
