			包含本Boss四把武器中的一把、专属专家饰品和金币；有概率获得面具
			'''
	}

	FrostNovaEmblem: {
		DisplayName: 冬痕护符
		Tooltip: 魔力上限增加20，免疫寒冷与霜焰
	}

