		Tooltip:
			'''
			Right-click to open
			Contains one of this boss's four weapons, its expert accessory and coins; may contain a mask
			'''
	}

	FrostNovaEmblem: {
		DisplayName: Winter Scar Charm
		Tooltip: Maximum mana +20; immunity to Chilled and Frostburn
	}

	FrostNovaMask: {
