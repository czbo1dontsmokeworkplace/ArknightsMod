		Tooltip:
			'''
			Right-click to open
			Contains one of this boss's four weapons, its expert accessory and coins; may contain a mask
			'''
	}

	PompeiiEmblem: {
		DisplayName: Volcanic Carapace
		Tooltip: Immunity to On Fire; attack speed +6%
	}

	PompeiiMask: {
