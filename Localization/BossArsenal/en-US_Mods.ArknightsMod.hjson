Items: {
	HarbingerGuillotine: {
		DisplayName: Harbinger Guillotine
		Tooltip:
			'''
			Fires crimson streaks and calls down a rain of light
			Hits leave lingering flames that seek enemies and explode
			'''
	}

	CatastropheSalvo: {
		DisplayName: Shrapnel Grenade
		Tooltip: Consumes rockets to fire accelerating shells with large explosions
	}

	ScarletMeson: {
		DisplayName: Scarlet Meson
		Tooltip: Hold left-click for intermittent lasers that stop at the first enemy or terrain
	}

	UrsusArtilleryLink: {
		DisplayName: Ursus Portable Mortar Emplacement
		Tooltip:
			'''
			Summons one following mortar to bombard enemies with arcing shells
			Occupies all minion slots, gaining damage for each slot
			'''
	}

	WinterScar: {
		DisplayName: Winter Scar
		Tooltip:
			'''
			Swings launch accelerating frost waves
			Pierces up to 4 enemies, fading with each hit
			'''
	}

	YetiSnowGrenade: {
		DisplayName: Yeti Snow Grenade
		Tooltip: Throws bouncing frost grenades that explode on enemy contact or fuse expiry
	}

	BlackIceCoffin: {
		DisplayName: Black Ice Coffin
		Tooltip:
			'''
			Forms three crystals above enemies that charge and fall
			Hits blacken nearby blocks; touching them removes 120 life per second
			Also harms players and bosses; overlapping areas do not stack
			'''
	}

	YetiChime: {
		DisplayName: Yeti Chime
		Tooltip:
			'''
			Summons one frost crystal, occupying all minion slots and scaling with their number
			Fires homing ice volleys, then a laser locked to one enemy
			'''
	}

	BasaltBreaker: {
		DisplayName: Basalt Breaker
		Tooltip:
			'''
			Swings throw two rolling meteors that last 3 seconds
