			Label: Blazing Sun's Obeisance
			Desc:
				'''
				Manual: ATK +140%, DEF +20, slash reach +15%; slashes ignore defense.
				Place a Blazing Sun within 480 pixels toward the cursor; it strikes and briefly stuns every second in a 120-pixel radius.
				'''
		}
	}

	AmbrielRifle: {
