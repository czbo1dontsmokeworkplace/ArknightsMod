Items: {
	MelanthasSword: {
		DisplayName: Standard Sword [Melantha]
		Tooltip:
			'''
			Early game
			Hold left-click to continuously repeat individual full-circle slashes. Each slash accelerates sharply across the front and slows behind you; turning reverses rotation.
			The blade deals damage on contact. Each turn hits its first enemy for 300% damage, 300% knockback and a guaranteed critical strike; subsequent enemies take 100% damage.
			Successful hits gradually increase attack frequency and weapon damage, both up to 150% of base. The overhead bar shows the buildup.
			While held, bonuses decay normally after 1 second without attacking. Switching away drains them 3 times faster; the overhead bar fades out after reaching zero.
			The first hit of each turn triggers the powerful impact sound and effects at the actual blade contact.
			'''
	}

	MataimaruGlaive: {
		DisplayName: Naginata [Matoimaru]
		Tooltip:
			'''
			Early Hardmode
			Hold left-click to continuously repeat individual full-circle slashes. Each slash accelerates sharply across the front and slows behind you; turning reverses rotation.
			The blade deals damage on contact. Each turn hits its first enemy for 300% damage, 300% knockback and a guaranteed critical strike; subsequent enemies take 100% damage.
			Successful hits gradually increase attack frequency and weapon damage, both up to 150% of base. The overhead bar shows the buildup.
			While held, bonuses decay normally after 1 second without attacking. Switching away drains them 3 times faster; the overhead bar fades out after reaching zero.
			The first hit of each turn triggers the powerful impact sound and effects at the actual blade contact.
