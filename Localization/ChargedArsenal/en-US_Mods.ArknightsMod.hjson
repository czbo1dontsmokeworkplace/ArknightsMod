Items: {
	MelanthaSword: {
		DisplayName: Melantha's Standard Sword
		Tooltip:
			'''
			Early game
			Hold left-click for 1 second, then release for a heavy sweep; an early release makes a weak slash.
			Heavy hits add an explosion and two fragments, up to six bursts per swing.
			'''
	}

	MatoimaruNaginata: {
		DisplayName: Matoimaru's Naginata
		Tooltip:
			'''
			Early Hardmode
			Hold left-click for 1 second, then release for a heavy sweep; an early release makes a weak slash.
			Heavy hits add an explosion and two fragments, up to six bursts per swing.
			'''
	}

	FrankaRapier: {
		DisplayName: Franka's Thermite Rapier
		Tooltip:
			'''
			Post-Plantera
			Hold left-click for 1 second, then release for a heavy sweep; an early release makes a weak slash.
			Heavy hits add an explosion and two fragments, up to six bursts per swing.
			Slashes have a 25% chance to ignore defense and ignite enemies.
			'''
	}

	NearlRadiantSword: {
		DisplayName: Radiant Nearl's Blazing Sun Swordlance
		Tooltip:
			'''
			Lunar events
			Hold left-click for 1 second, then release for a heavy sweep; an early release makes a weak slash.
			Heavy hits add an explosion and two fragments, up to six bursts per swing.
			'''
	}

	AmbrielRifle: {
		DisplayName: Ambriel's Longshot Rifle
		Tooltip:
			'''
			Post-Skeletron
			Hold left-click to automatically fire one straight special bullet every 60 ticks for 100% damage.
			Hold right-click for 1.5 seconds, then release. Full charge fires a 360% damage laser with unlimited enemy piercing.
			Releasing right-click below full charge fires a special bullet that hits up to 4 enemies: 50% damage at 0% charge, 100% damage at 80%-99% charge.
			Right-click bullet damage rises linearly from 0% to 80% charge. Converts all ammunition and consumes one bullet per shot. Charging does not reduce movement speed.
			'''
	}

	AndreanaRifle: {
		DisplayName: Andreana's Inkshot Rifle
		Tooltip:
			'''
			Early Hardmode
			Hold left-click to automatically fire one straight special bullet every 60 ticks for 100% damage.
			Hold right-click for 1.5 seconds, then release. Full charge fires a 360% damage laser with unlimited enemy piercing.
			Releasing right-click below full charge fires a special bullet that hits up to 4 enemies: 50% damage at 0% charge, 100% damage at 80%-99% charge.
			Right-click bullet damage rises linearly from 0% to 80% charge. Converts all ammunition and consumes one bullet per shot. Charging does not reduce movement speed.
			'''
	}

	FirewatchRifle: {
		DisplayName: Firewatch's Woodland Sniper
		Tooltip:
			'''
			Post-Plantera
			Hold left-click to automatically fire one straight special bullet every 60 ticks for 100% damage.
			Hold right-click for 1.5 seconds, then release. Full charge fires a 360% damage laser with unlimited enemy piercing.
			Releasing right-click below full charge fires a special bullet that hits up to 4 enemies: 50% damage at 0% charge, 100% damage at 80%-99% charge.
			Right-click bullet damage rises linearly from 0% to 80% charge. Converts all ammunition and consumes one bullet per shot. Charging does not reduce movement speed.
			'''
	}

	FartoothGreatbow: {
		DisplayName: Fartooth's Feathershine Greatbow
		Tooltip:
			'''
			Lunar events
			Hold left-click to fire one 100% damage high-speed special bullet every 60 ticks, without recoil; hits up to 4 enemies.
			Hold right-click to load up to 6 feathershine blades. Each costs one bullet and reduces the next loading time by 5%.
			Blades line up in parallel around the center and launch together on release, each dealing 100% damage, piercing walls and enemies without homing or gravity.
			Uses vanilla Terraprisma blade art for now. Loading does not slow movement; switching weapons cancels the load.
			After 5 seconds without taking damage, feathershine shots deal 20% more damage.
			'''
	}
	MelaniteCrossbow: {
		DisplayName: Melanite's Helix Crossbow
		Tooltip:
			'''
			Mechanical Boss progression
			Converts arrows into heavy bolts wrapped in two purple helices. Fires one piercing arrow per shot.
			'''
	}

	ProvenceCrossbow: {
		DisplayName: Provence's Heavy Crossbow
		Tooltip:
			'''
			Post-Plantera
			Uses arrows, converting them to unique crossbow bolts.
			'''
	}

	GreyThroatCrossbow: {
		DisplayName: GreyThroat's Feather Crossbow
		Tooltip:
			'''
			Mechanical bosses
			Uses arrows, converting them to unique crossbow bolts.
			'''
	}

	BluePoisonCrossbow: {
		DisplayName: Blue Poison's Venom Crossbow
		Tooltip:
			'''
			Post-Plantera
			Converts arrows into venom bolts. Hold left-click for rapid four-shot bursts.
			'''
	}
}

