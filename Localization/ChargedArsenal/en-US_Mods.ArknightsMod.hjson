		DisplayName: Naginata [Matoimaru]
		Tooltip: Hold left-click to chain slashes with the naginata
	}

	FrankaRapier: {
		DisplayName: Thermite Rapier [Franka]
		Tooltip:
			'''
			Hold left-click to chain slashes with the thermite blade
			Slashes have a 25% chance to ignore defense and set enemies ablaze
			'''
	}

	NearlRadiantSword: {
		DisplayName: Blazing Sun Swordlance [Radiant Nearl]
		Tooltip: Hold left-click to chain slashes with the swordlance
	}

	AmbrielRifle: {
		DisplayName: Longshot Rifle [Ambriel]
		Tooltip:
			'''
			Converts bullets into straight-flying special rounds
			Release right-click after a full charge to fire a powerful piercing laser; releasing early cancels the shot
			Each shot consumes 1 bullet; charging does not reduce movement speed
			'''
	}

	AndreanaRifle: {
		DisplayName: Inkshot Rifle [Andreana]
		Tooltip:
			'''
			Converts bullets into straight-flying special rounds
			Release right-click after a full charge to fire a powerful piercing laser; releasing early cancels the shot
			Each shot consumes 1 bullet; charging does not reduce movement speed
			'''
	}

	FirewatchRifle: {
		DisplayName: Woodland Sniper [Firewatch]
		Tooltip:
			'''
			Converts bullets into straight-flying special rounds
			Release right-click after a full charge to fire a powerful piercing laser; releasing early cancels the shot
			Each shot consumes 1 bullet; charging does not reduce movement speed
			'''
	}

	MelaniteCrossbow: {
		DisplayName: Helix Crossbow [Melanite]
		Tooltip:
			'''
			Converts arrows into spiral bolts that pierce up to 6 enemies
			Grants 12 armor penetration
			'''
	}

	ProvenceCrossbow: {
		DisplayName: Heavy Crossbow [Provence]
		Tooltip:
			'''
			Converts arrows into slow-firing heavy bolts that pierce up to 9 enemies
			Grants 25 armor penetration
			'''
	}

	GreyThroatCrossbow: {
		DisplayName: Feather Crossbow [GreyThroat]
		Tooltip: Converts arrows into special bolts fired in rapid three-shot bursts
	}

	BluePoisonCrossbow: {
		DisplayName: Venom Crossbow [Blue Poison]
		Tooltip:
			'''
			Converts arrows into venom bolts fired in rapid four-shot bursts
			Bolts hit up to 2 enemies and inflict Venom
			'''
	}
}

Skills: {
	MelanthasSword: {
		1: {
			Label: ATK Up α
			Desc: Manual: ATK +50%.
		}
	}

	MataimaruGlaive: {
		1: {
			Label: Regeneration β
			Desc: Manual: immediately restore 50% of maximum life, then end.
		}

		2: {
			Label: Demonic Power
			Desc: Manual: ATK +150%; your defense becomes 0.
		}
	}

	FrankaRapier: {
		1: {
			Label: Swift Strike γ
			Desc: Manual: ATK +45%; base rotation time becomes 21 ticks.
		}

		2: {
			Label: Vorpal Edge
			Desc: Manual: ATK +100%, your defense becomes 0; slash defense-ignore chance rises from 25% to 75%.
		}
	}

	NearlRadiantSword: {
		1: {
			Label: Flaming Edge
			Desc: Manual: ATK +70%, slash reach +15%, base rotation time becomes 21 ticks.
		}

		2: {
			Label: Night-Scouring Gleam
			Desc: Manual: ATK +110%; gain four shields that block incoming hits. Shields expire when switching weapons or when the skill ends.
		}

		3: {
			Label: Blazing Sun's Obeisance
			Desc:
				'''
				Manual: ATK +140%, DEF +20, slash reach +15%; slashes ignore defense.
				Place a Blazing Sun within 480 pixels toward the cursor; it strikes and briefly stuns every second in a 120-pixel radius.
				'''
		}
	}

	AmbrielRifle: {
		1: {
			Label: Snaring Shells
			Desc: Manual: shot hits stun for 0.6 seconds using the mod's stun rules.
		}

		2: {
			Label: Radar Sweep
			Desc: Manual: ATK +80%; shots pass through terrain and travel up to 3200 pixels.
		}
	}

	AndreanaRifle: {
		1: {
			Label: ATK Up γ
			Desc: Manual: ATK +100%.
		}

		2: {
			Label: Interdictive Sniping
			Desc: Manual: ATK +240%; only hits enemies above 50% life, stunning them for 1 second.
		}
	}

	FirewatchRifle: {
		1: {
			Label: Camouflage
			Desc: Manual: ATK +140%; reduce enemy aggression and conceal your sprite. Contact and projectile damage still apply.
		}

		2: {
			Label: Tactical Transceiver
			Desc:
				'''
				Manual: designate three positions within 1100 pixels toward the cursor; each explodes after 0.75 seconds.
				Each blast deals 400% base weapon damage in a 130-pixel radius.
				'''
		}
	}

	MelaniteCrossbow: {
		1: {
			Label: Helix Overpressure
			Desc: Automatic: the next single bolt deals 220% damage, retaining six-target piercing and 12 armor penetration.
		}

		2: {
			Label: Penetration Unbound
			Desc: Manual: for 20 seconds, each single bolt deals 165% damage, pierces eight enemies and gains 20 total armor penetration.
		}
	}

	ProvenceCrossbow: {
		1: {
			Label: Wolf's Eye
			Desc: Automatic: for 20 seconds, damage scales with the target's missing life, up to +60%.
		}

		2: {
			Label: Scent of Prey
			Desc: Manual: shots deal 240% damage, but can only hit enemies at or below 80% life.
		}
	}

	GreyThroatCrossbow: {
		1: {
			Label: Flying Feather
			Desc: Automatic: next shot fires two arrows at 140% damage each, consuming one arrow.
		}

		2: {
			Label: Crossfire
			Desc: Manual: ATK +40%; intervals within three-shot bursts are reduced by 35%.
		}
	}

	BluePoisonCrossbow: {
		1: {
			Label: Double Shot
			Desc: Automatic: next shot deals 180% damage and adds one arrow, preferring another target.
		}

		2: {
			Label: Venom Spray
			Desc: Manual: shots deal 150% damage and add two arrows, preferring other targets.
		}
	}
}

