				Damage increases by another 40% after the shot travels 800 pixels.
				'''
		}
	}

	MelaniteCrossbow: {
		1: {
			Label: Helix Overpressure
			Desc: Automatic: the next single bolt deals 220% damage, retaining six-target piercing and 12 armor penetration.
		}

