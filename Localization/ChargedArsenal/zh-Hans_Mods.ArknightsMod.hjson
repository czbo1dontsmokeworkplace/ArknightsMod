Items: {
	MelanthaSword: {
		DisplayName: 玫兰莎的制式长剑
		Tooltip:
			'''
			开局
			按住左键蓄力1秒，松手发动大范围重斩；提前松手为弱斩。
			重斩命中追加爆炸与2枚碎片，每次斩击最多触发6组。
			'''
	}

	MatoimaruNaginata: {
		DisplayName: 缠丸的薙刀
		Tooltip:
			'''
			困难模式初期
			按住左键蓄力1秒，松手发动大范围重斩；提前松手为弱斩。
			重斩命中追加爆炸与2枚碎片，每次斩击最多触发6组。
			'''
	}

	FrankaRapier: {
		DisplayName: 芙兰卡的热熔剑
		Tooltip:
			'''
			世纪之花后
			按住左键蓄力1秒，松手发动大范围重斩；提前松手为弱斩。
			重斩命中追加爆炸与2枚碎片，每次斩击最多触发6组。
			斩击有25%概率忽略防御，并使敌人燃烧。
			'''
	}

	NearlRadiantSword: {
		DisplayName: 耀骑士临光的耀阳剑枪
		Tooltip:
			'''
			四柱时期
			按住左键蓄力1秒，松手发动大范围重斩；提前松手为弱斩。
			重斩命中追加爆炸与2枚碎片，每次斩击最多触发6组。
			'''
	}

	AmbrielRifle: {
		DisplayName: 安比尔的远射步枪
		Tooltip:
			'''
			骷髅王后
			按住左键每60帧自动射出一发笔直的专属子弹，造成100%伤害。
			按住右键蓄力1.5秒，松手射击；满蓄力发射360%伤害的强力激光，可无限贯穿敌人。
			右键未满蓄力时发射专属子弹，最多命中4个敌人；0%蓄力造成50%伤害，80%至99%蓄力造成100%伤害。
			右键子弹伤害在0%至80%蓄力间线性提高；所有弹药统一转换，射击消耗1发子弹。蓄力期间不降低移动速度。
			'''
	}

	AndreanaRifle: {
		DisplayName: 安哲拉的墨色铳
		Tooltip:
			'''
			困难模式初期
			按住左键每60帧自动射出一发笔直的专属子弹，造成100%伤害。
			按住右键蓄力1.5秒，松手射击；满蓄力发射360%伤害的强力激光，可无限贯穿敌人。
			右键未满蓄力时发射专属子弹，最多命中4个敌人；0%蓄力造成50%伤害，80%至99%蓄力造成100%伤害。
			右键子弹伤害在0%至80%蓄力间线性提高；所有弹药统一转换，射击消耗1发子弹。蓄力期间不降低移动速度。
			'''
	}

	FirewatchRifle: {
		DisplayName: 守林人的林间狙击弩
		Tooltip:
			'''
			世纪之花后
			按住左键每60帧自动射出一发笔直的专属子弹，造成100%伤害。
			按住右键蓄力1.5秒，松手射击；满蓄力发射360%伤害的强力激光，可无限贯穿敌人。
			右键未满蓄力时发射专属子弹，最多命中4个敌人；0%蓄力造成50%伤害，80%至99%蓄力造成100%伤害。
			右键子弹伤害在0%至80%蓄力间线性提高；所有弹药统一转换，射击消耗1发子弹。蓄力期间不降低移动速度。
			'''
	}

	FartoothGreatbow: {
		DisplayName: 远牙的光羽大弓
		Tooltip:
			'''
			四柱时期
			按住左键每60帧射出一发100%伤害的高速专属子弹，无后坐动作，最多命中4个敌人。
			按住右键逐发装填光羽剑，最多6发；每发消耗1发子弹，下一发装填时间缩短5%。
			光羽剑居中平行排列，松手同时射出，每发造成100%伤害，不追踪、穿墙、无重力、无限贯穿敌人。
			光羽剑暂用原版夜明剑贴图；装填期间不减速，切换武器取消本轮装填。
			连续5秒未受伤后，光羽射击伤害提高20%。
			'''
	}
	MelaniteCrossbow: {
		DisplayName: 玫拉的螺旋重弩
		Tooltip:
			'''
			机械Boss阶段
			使用箭矢，统一转换为紫色双螺旋重矢；每次射击发射一支贯穿箭。
			'''
	}

	ProvenceCrossbow: {
		DisplayName: 普罗旺斯的重型弩
		Tooltip:
			'''
			世纪之花后
			使用箭矢，统一转换为专属弩箭。
			'''
	}

	GreyThroatCrossbow: {
		DisplayName: 灰喉的飞羽弩
		Tooltip:
			'''
			机械Boss阶段
			使用箭矢，统一转换为专属弩箭。
			'''
	}

	BluePoisonCrossbow: {
		DisplayName: 蓝毒的淬毒弩
		Tooltip:
			'''
			世纪之花后
			使用箭矢，统一转换为淬毒弩箭；按住左键进行快速四连发。
			'''
	}
}

Skills: {
	MelanthaSword: {
		1: {
			Label: 攻击力强化·α型
			Desc: 手动开启，攻击力提高50%。
		}
	}

	MatoimaruNaginata: {
		1: {
			Label: 生命回复·β型
			Desc: 手动开启，立即回复50%最大生命，随后结束。
		}

		2: {
			Label: 恶鬼之力
			Desc: 手动开启，攻击力提高150%，自身防御降至0。
		}
	}

	FrankaRapier: {
		1: {
			Label: 迅捷打击·γ型
			Desc: 手动开启，攻击力提高45%，斩击动作缩短至21帧；蓄力仍为1秒。
		}

		2: {
			Label: 极致锋度
			Desc: 手动开启，攻击力提高100%，自身防御降至0；斩击忽略防御的概率由25%提升至75%。
		}
	}

	NearlRadiantSword: {
		1: {
			Label: 灿焰长刃
			Desc: 手动开启，攻击力提高70%，斩击范围提高15%，动作缩短至21帧；蓄力仍为1秒。
		}

		2: {
			Label: 逐夜烁光
			Desc: 手动开启，攻击力提高110%，获得4层抵挡伤害的护盾。切换武器或技能结束时护盾消失。
		}

		3: {
			Label: 耀阳颔首
			Desc:
				'''
				手动开启，攻击力提高140%，防御+20，斩击范围提高15%，斩击忽略防御。
				在鼠标方向480像素内放置耀阳，半径120像素内每秒攻击并短暂眩晕。
				'''
		}
	}

	AmbrielRifle: {
		1: {
			Label: 阻挡弹
			Desc: 手动开启，射击命中使目标眩晕0.6秒，遵循模组眩晕规则。
		}

		2: {
			Label: 雷达定位
			Desc: 手动开启，攻击力提高80%，弹道可穿过地形，最大飞行距离提高至3200像素。
		}
	}

	AndreanaRifle: {
		1: {
			Label: 攻击力强化·γ型
			Desc: 手动开启，攻击力提高100%。
		}

		2: {
			Label: 阻滞射击战术
			Desc: 手动开启，攻击力提高240%，仅命中当前生命超过50%的敌人；命中眩晕1秒。
		}
	}

	FirewatchRifle: {
		1: {
			Label: 环境伪装
			Desc: 手动开启，攻击力提高140%，降低仇恨并隐蔽身形；仍会受到碰撞和弹幕伤害。
		}

		2: {
			Label: 战术电台
			Desc:
				'''
				手动开启，在鼠标方向1100像素内标记3处位置，0.75秒后分别爆炸。
				每次造成基础武器伤害的400%，爆炸半径130像素。
				'''
		}
	}

	FartoothGreatbow: {
		1: {
			Label: 迅捷打击·γ型
			Desc: 手动开启，攻击力提高45%，射后恢复从24帧缩短至16帧。
		}

		2: {
			Label: 同盟支援
			Desc: 手动开启，射后动作恢复缩短至10帧；右键装填的光羽剑保持平行齐射。
		}

		3: {
			Label: 光羽箭
			Desc:
				'''
				手动开启，攻击力提高140%，射程提高至3200像素，护甲穿透+35。
				弹道飞行超过800像素后伤害再提高40%。
				'''
		}
	}

	MelaniteCrossbow: {
		1: {
			Label: 螺旋增压
			Desc: 自动触发，下次单发重矢造成220%伤害，保持6次贯穿与12点护甲穿透。
		}

		2: {
			Label: 贯穿解限
			Desc: 手动开启，20秒内单发重矢造成165%伤害，可贯穿8个敌人，护甲穿透提高至20。
		}
	}

	ProvenceCrossbow: {
		1: {
			Label: 狼眼
			Desc: 自动触发，20秒内按目标已损生命比例增加伤害，最高增加60%。
		}

		2: {
			Label: 杀戮嗅觉
			Desc: 手动开启，射击造成240%伤害，但只能命中当前生命不超过80%的敌人。
		}
	}

	GreyThroatCrossbow: {
		1: {
			Label: 飞羽
			Desc: 自动触发，下次射击发射2支箭，每支造成140%伤害，只消耗1支箭矢。
		}

		2: {
			Label: 回流
			Desc: 手动开启，攻击力提高40%，三连发射击间隔缩短35%。
		}
	}

	BluePoisonCrossbow: {
		1: {
			Label: 二重射击·自动
			Desc: 自动触发，下次射击造成180%伤害并额外发射1支箭，优先分配给其他目标。
		}

		2: {
			Label: 毒液散射
			Desc: 手动开启，射击造成150%伤害，每次额外发射2支箭，优先分配给其他目标。
		}
	}
}

