			'''
	}

	FartoothGreatbow: {
		DisplayName: 远牙的光羽大弓
		Tooltip:
			'''
			四柱时期
			按住左键蓄力1.5秒，两条瞄准线闭合时达到最强，松手射击。
			蓄力越久，伤害、弹道尺寸和击退越强；横向移动逐渐降至12%。
