Skills: {
	MelanthasSword: {
		1: {
			Label: 攻击力强化·α型
			Desc: 手动开启，攻击力提高50%。
		}
	}

	MataimaruGlaive: {
		1: {
			Label: 生命回复·β型
			Desc: 手动开启，立即回复50%最大生命，随后结束。
		}

		2: {
			Label: 恶鬼之力
			Desc: 手动开启，攻击力提高150%，自身防御降至0。
		}
	}

	FrankaRapier: {
		1: {
			Label: 迅捷打击·γ型
			Desc: 手动开启，攻击力提高45%，每圈基础动作缩短至21帧。
		}

		2: {
			Label: 极致锋度
			Desc: 手动开启，攻击力提高100%，自身防御降至0；斩击忽略防御的概率由25%提升至75%。
		}
	}

	NearlRadiantSword: {
		1: {
			Label: 灿焰长刃
			Desc: 手动开启，攻击力提高70%，斩击范围提高15%，每圈基础动作缩短至21帧。
		}

		2: {
			Label: 逐夜烁光
			Desc: 手动开启，攻击力提高110%，获得4层抵挡伤害的护盾。切换武器或技能结束时护盾消失。
		}

		3: {
			Label: 耀阳颔首
			Desc:
				'''
				手动开启，攻击力提高140%，防御+20，斩击范围提高15%，斩击忽略防御。
				在鼠标方向480像素内放置耀阳，半径120像素内每秒攻击并短暂眩晕。
				'''
		}
	}

	AmbrielRifle: {
		1: {
			Label: 阻挡弹
			Desc: 手动开启，射击命中使目标眩晕0.6秒，遵循模组眩晕规则。
		}

