Items: {
	MelanthaSword: {
		DisplayName: 玫兰莎的制式长剑
		Tooltip:
			'''
			开局
			按住左键蓄力1秒，松手发动大范围重斩；提前松手为弱斩。
			重斩命中追加爆炸与2枚碎片，每次斩击最多触发6组。
			'''
	}

	MatoimaruNaginata: {
		DisplayName: 缠丸的薙刀
		Tooltip:
			'''
			困难模式初期
			按住左键蓄力1秒，松手发动大范围重斩；提前松手为弱斩。
			重斩命中追加爆炸与2枚碎片，每次斩击最多触发6组。
			'''
	}

	FrankaRapier: {
		DisplayName: 芙兰卡的热熔剑
		Tooltip:
			'''
			世纪之花后
			按住左键蓄力1秒，松手发动大范围重斩；提前松手为弱斩。
			重斩命中追加爆炸与2枚碎片，每次斩击最多触发6组。
			斩击有25%概率忽略防御，并使敌人燃烧。
			'''
	}

	NearlRadiantSword: {
		DisplayName: 耀骑士临光的耀阳剑枪
		Tooltip:
			'''
			四柱时期
			按住左键蓄力1秒，松手发动大范围重斩；提前松手为弱斩。
			重斩命中追加爆炸与2枚碎片，每次斩击最多触发6组。
			'''
	}

	AmbrielRifle: {
		DisplayName: 安比尔的远射步枪
		Tooltip:
			'''
			骷髅王后
			按住左键蓄力1.5秒，两条瞄准线闭合时达到最强，松手射击。
			蓄力越久，伤害、弹道尺寸和击退越强；横向移动逐渐降至12%。
			每次松手射击消耗1发子弹，统一转换为专属弹道。
			'''
	}

	AndreanaRifle: {
		DisplayName: 安哲拉的墨色铳
		Tooltip:
			'''
			困难模式初期
			按住左键蓄力1.5秒，两条瞄准线闭合时达到最强，松手射击。
			蓄力越久，伤害、弹道尺寸和击退越强；横向移动逐渐降至12%。
			每次松手射击消耗1发子弹，统一转换为专属弹道。
			'''
	}

	FirewatchRifle: {
		DisplayName: 守林人的林间狙击弩
		Tooltip:
			'''
			世纪之花后
			按住左键蓄力1.5秒，两条瞄准线闭合时达到最强，松手射击。
			蓄力越久，伤害、弹道尺寸和击退越强；横向移动逐渐降至12%。
