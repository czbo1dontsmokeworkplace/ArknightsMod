Items: {
	MelanthasSword: {
		DisplayName: 制式长剑 [玫兰莎]
		Tooltip:
			'''
			开局
			按住左键逐次连续进行整圈挥斩；每次挥动在正面迅速加速、身后放慢，转身后反向旋转。
			刀刃接触立即造成伤害：每圈首个命中目标受到300%伤害、300%击退并必定暴击；后续目标受到100%伤害。
			有效命中逐渐提高攻击频率和面板伤害，最高均为基础值的150%；积累进度显示在头顶条中。
			手持停攻1秒后增益正常衰减；切走后以3倍速度衰减，头顶条归零后淡出。
			每圈首次命中在刀刃实际接触位置触发专属重击音效与猛烈特效。
			'''
	}

	MataimaruGlaive: {
