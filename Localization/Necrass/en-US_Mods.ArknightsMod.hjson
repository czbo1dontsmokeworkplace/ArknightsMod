Items: {
	NecrassScepter: {
		DisplayName: Necrass's Rekindling Scepter
		Tooltip:
			'''
			Fires homing violet flames; nearby enemy deaths create Lamenting Servants
			Servants inherit this weapon's magic damage, use no minion slots, have their own health and dissolve when the weapon is put away
			'''
	}
}

Skills: {
	NecrassScepter: {
		1: {
			Label: Dread Wish
			Desc: Servant creation and first empowerment deal 250%-450% area magic damage. Activate to recreate all servants; empowered servants provide two summons. Creates one servant if none exist
		}

		2: {
			Label: Wither
			Desc: Puts 2-3 nearby enemies to sleep for 12 seconds, dealing 70%-160% magic damage every half second. Marked deaths provide two additional summons. Bosses, segmented enemies and knockback-immune enemies take damage without being immobilized. Sleeping enemies remain vulnerable
		}

		3: {
			Label: Crown the Dead
			Desc: One servant takes a special crowned form. Activate for 2-3 pulses of 450%-800% area magic damage. Each pulse sacrifices an ordinary servant to empower and heal the crowned servant by 20%; empowered offerings count twice. Up to six upgrades; upgrades 3 and 6 extend reach, and upgrade 3 unlocks a violet thrust. The crowned servant dissolves when another skill is selected
		}
	}
}

Projectiles: {
	NecrassCourt.DisplayName: Rekindling Crown
	NecrassServant.DisplayName: Lamenting Servant
	NecrassSoulBolt.DisplayName: Rekindled Flame
	NecrassImpact.DisplayName: Soulfire Surge
	NecrassSleep.DisplayName: Wither
	NecrassRitual.DisplayName: Coronation
	NecrassOffering.DisplayName: Soul Offering
}
