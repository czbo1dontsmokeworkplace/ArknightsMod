Items: {
	NecrassScepter: {
		DisplayName: 死芒的复燃权杖
		Tooltip:
			'''
			从身边连发一至两道朝向鼠标的紫焰，沿曲线加速并延迟追踪敌人
			六道紫焰分摊一轮攻击伤害，附近敌人死亡时塑造悲叹的仆役
			仆役继承本武器的魔法伤害，不占召唤栏；具有独立生命，离手后消散
			'''
	}
}

Skills: {
	NecrassScepter: {
		1: {
			Label: 噩愿
			Desc: 仆役生成或首次升级时造成250%～450%范围法术伤害。开启时重新召唤全部仆役，已强化仆役提供两次召唤；空场时召唤一名
		}

		2: {
			Label: 折朽
			Desc: 令附近2～3个敌人沉睡12秒，每半秒造成70%～160%法术伤害，其间目标死亡时额外提供两次召唤。首领、多节生物和不可击退敌人只受伤害，不受控制；沉睡目标仍可被攻击
		}

		3: {
			Label: 冠死以冕
			Desc: 最多一名仆役以特殊大兵形态出现。开启时连续造成2～3次450%～800%范围法术伤害，每次献祭一名普通仆役强化大兵并回复20%生命，已强化仆役效果翻倍。大兵最多强化6次，第3及6次延长攻击距离，第3次解锁紫焰突刺；切换其他技能时大兵消散
		}
	}
}

Projectiles: {
	NecrassCourt.DisplayName: 复燃冠冕
	NecrassServant.DisplayName: 悲叹的仆役
	NecrassSoulBolt.DisplayName: 复燃紫焰
	NecrassImpact.DisplayName: 塑灵焰潮
	NecrassSleep.DisplayName: 折朽
	NecrassRitual.DisplayName: 冠冕仪式
	NecrassOffering.DisplayName: 仆役献祭
}
