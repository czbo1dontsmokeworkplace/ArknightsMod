Items: {
	GraniLance: {
		DisplayName: Folding Lance [Grani]
		Tooltip:
			'''
			Thrusts forward, scattering damaging sparks on hit
			Grants a 20% chance to dodge damage while held
			'''
	}

	WildManeLance: {
		DisplayName: Charge Lance [Wild Mane]
		Tooltip:
			'''
			Thrusts forward, scattering damaging sparks on hit
			Charges can pass through multiple enemies
			'''
	}
}

Skills: {
	GraniLance: {
		1: {
			Label: DEF Up γ
			Desc: Manual. DEF +100% for 40 seconds. Initial SP: 15. Cost: 30.
		}

		2: {
			Label: Never Retreat!
			Desc: Manual. ATK and DEF +80%, knockback immunity, and 15% shorter left-click reach for 30 seconds. Initial SP: 20. Cost: 40.
		}
	}

	WildManeLance: {
		1: {
			Label: Lance Charge
			Desc: Activates automatically when attacking: left-click attack speed +80% for 15 seconds. Initially ready; subsequent activations cost 30 SP.
		}

		2: {
			Label: Lance Showdown
			Desc: Manual. ATK +80%, left-click reach +20%, and double knockback for 20 seconds. Initial SP: 10. Cost: 30.
		}
	}
}

VanguardSpears: {
	Cost: Kills while held produce 1 Deployment Cost; 1 Cost restores 1 SP to the currently held weapon
	Controls:
		'''
		Charges deal {0}x damage and share a {1}-second cooldown; release or hit terrain to stop
		Charging prevents enemy contact damage, but not projectile damage; cannot charge while mounted or using a grappling hook
		'''
	SkillKey: Press [{0}] to activate the selected manual skill
	Unbound: Bind Skill Activate under Settings → Controls → Mod Controls.
	Placeholder: Weapon art and skill icons use temporary sprites
}

