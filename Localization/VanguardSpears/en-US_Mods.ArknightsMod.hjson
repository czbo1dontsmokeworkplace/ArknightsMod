Items: {
	GraniLance: {
		DisplayName: Folding Lance [Grani]
		Tooltip:
			'''
			Early Hardmode
			Charges pierce enemies, dealing direct damage once per enemy.
			Holding this weapon grants a 20% chance to dodge damage.
			'''
	}

	WildManeLance: {
		DisplayName: Charge Lance [Wild Mane]
		Tooltip:
			'''
			After all Mechanical Bosses
			Charging through enemies releases orange lance bursts and tearing sparks.
			'''
	}
}

Skills: {
	GraniLance: {
		1: {
			Label: DEF Up γ
			Desc: Manual. DEF +100% for 40 seconds. Initial SP: 15. Cost: 30.
		}

		2: {
			Label: Never Retreat!
			Desc: Manual. ATK and DEF +80%, knockback immunity, and 15% shorter left-click reach for 30 seconds. Initial SP: 20. Cost: 40.
		}
	}

	WildManeLance: {
		1: {
			Label: Lance Charge
			Desc: Activates automatically when attacking: left-click attack speed +80% for 15 seconds. Initially ready; subsequent activations cost 30 SP.
		}

		2: {
			Label: Lance Showdown
			Desc: Manual. ATK +80%, left-click reach +20%, and double knockback for 20 seconds. Initial SP: 10. Cost: 30.
		}
	}
}

VanguardSpears: {
	Controls:
		'''
		Left-click thrusts toward the cursor. Hits scatter 1 to 3 falling sparks, each dealing 18% of that thrust's damage.
		Right-click charges toward the cursor for {0}x damage, directly hitting each enemy at most once per charge.
		Charges last 28 frames and travel about {2} pixels, stop at tiles, and prevent contact damage while moving.
		All four weapons share a fixed {1}-second cooldown that continues while unequipped. Melee hits do not reduce it.
		The first charge hit releases 6 to 9 falling sparks, each dealing 10% of the charge's damage.
		Sparks deal damage after 5 frames, hitting up to 5 times total with a 15-frame cooldown per enemy.
		Charges cannot start while mounted or using a grappling hook.
		'''
	SkillKey: Press [{0}] for manual skills; click a skill icon to select it.
	Unbound: Bind Skill Activate under Settings → Controls → Mod Controls.
	Placeholder: Weapon art and skill icons temporarily reuse existing mod assets.
}

