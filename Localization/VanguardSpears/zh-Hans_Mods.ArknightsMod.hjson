	GraniLance: {
		1: {
			Label: 防御力强化·γ型
			Desc: 手动开启，防御力+100%，持续40秒。初始技力15，消耗30。
		}

		2: {
			Label: 永不后退！
			Desc: 手动开启，攻击力与防御力+80%，免疫击退，左键攻击范围缩短15%，持续30秒。初始技力20，消耗40。
		}
	}

	WildManeLance: {
		1: {
			Label: 骑枪刺击
			Desc: 攻击时自动开启，左键攻速+80%，持续15秒。首次持握即就绪；之后消耗30点技力。
		}

		2: {
			Label: 枪锋相对
			Desc: 手动开启，攻击力+80%，左键范围扩大20%，击退翻倍，持续20秒。初始技力10，消耗30。
		}
	}
}

VanguardSpears: {
	Controls:
		'''
		左键沿瞄准方向戳刺，命中向前抛出1至3枚下落火花，每枚造成该次刺击18%的伤害。
		右键向瞄准方向进行长距离骑枪冲锋，造成{0}倍伤害，每个敌人每次冲锋至多直接命中一次。
		冲锋持续28帧，完整距离约{2}像素；撞墙停止，冲锋期间免疫接触伤害。
		四把武器共用{1}秒固定冷却，切换后继续计时；近战命中不会缩短冷却。
		首次冲锋命中释放6至9枚下落火花，每枚造成冲锋10%的伤害。
		火花5帧后可伤害，同一敌人每15帧至多命中一次，总计至多5次。
		坐骑或钩爪使用期间无法发起冲锋。
		'''
	SkillKey: 按[{0}]开启手动技能；点击技能图标切换技能。
	Unbound: 请在设置 → 控制 → 模组按键中绑定“技能开启”。
	Placeholder: 武器和技能图标暂借用本模组现有资源作为占位。
}

