			持握时有20%概率闪避伤害。
			'''
	}

	WildManeLance: {
		DisplayName: 冲锋骑枪 [野鬃]
		Tooltip:
			'''
			全部机械Boss后
			冲锋穿过敌人时释放橙色枪锋与撕流火花。
			'''
