Items: {
	CallOfTheTides: {
		DisplayName: 归溟之唤
		Tooltip:
			'''
			在击败月亮领主后，于海洋召唤伊莎玛拉
			不会消耗
			开场歌声会抑制飞行；多段跳、跳跃增益与钩爪仍可使用
			'''
	}

	AbyssalSpine: {
		DisplayName: 溟海脊索
		Tooltip:
			'''
			挥舞海龙骨骼构成的链枷
			按住左键旋转，松开抛出，再次按下将其收回
			'''
	}

	HeavensDeluge: {
		DisplayName: 天洪
		Tooltip: 消耗凝胶，持续喷射可贯穿敌人的高压水流
	}

	FinalTideFlute: {
		DisplayName: 终潮之笛
		Tooltip: 吹奏潮音，释放三股交织前进的螺旋水流
	}

	TidebornStaff: {
		DisplayName: 潮生之杖
		Tooltip: 召唤潮生海嗣，以水流协同攻击敌人
	}

	HeartOfTheTides: {
		DisplayName: 归溟之心
		Tooltip:
			'''
			增加60点生命上限与6%全职业伤害
			连续10秒未受伤后凝聚水膜，使下一次受击伤害降低20%
			'''
	}

	IsharmlaTreasureBag: {
		DisplayName: 宝藏袋（伊莎玛拉）
		Tooltip: 右键打开
	}
}

