Dropconfig: {
	DisplayName: Loot Drop Chances

	DropOriginiumSlugPercent: {
		Label: Originium Slug Orirock Cube chance (%)
		Tooltip: Enter a percentage: 0 disables the drop, 100 guarantees it. Decimals are supported; changes apply when saved.
	}

	DropOriginiumSlugAlphaPercent: {
		Label: Originium Slug Alpha Orirock Cube chance (%)
		Tooltip: Enter a percentage: 0 disables the drop, 100 guarantees it. Decimals are supported; changes apply when saved.
	}

