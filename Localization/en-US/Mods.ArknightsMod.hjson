Items: {
	EvolutionTreasureBag: {
		DisplayName: Treasure Bag (Essence of Evolution)
		Tooltip: Right click to receive one each of Origin of Evolution, Terminus of Evolution, Terminus Light, Origin Sever, Nest of Life, and Bloodlight Calamity
	}

	EvolutionSummon: {
		DisplayName: Origin of Evolution
		Tooltip:
			'''
			The beginning of Earth's humanity's forbidden glimpse into Originium technology—and its end
			Summons the Essence of Evolution
			Can be used on the surface at any time
			Requires defeating all three mechanical bosses
			'''
	}

	EvolutionOrigin: {
		DisplayName: Origin of Evolution
		Tooltip:
			'''
			+6 defense, +40 maximum life and +5% damage reduction
			Enemy kills grant one Evolution stack when no major boss is alive, up to 25
			Event bosses and minibosses do not prevent stacking
			Each stack grants +0.4 defense, +0.25% damage, +0.15% critical strike chance and +0.2% movement speed
			After 20 seconds without a kill, lose one stack per second; death or unequipping clears all stacks
			'''
	}

	EvolutionTerminus: {
		DisplayName: Terminus of Evolution
		Tooltip:
			'''
			+10% damage, +8% critical strike chance, +8% attack speed and +10% movement speed
			Lethal damage instead triggers a 10-second Final Evolution
			Become invulnerable and gain an additional +50% damage, +30% critical strike chance
			Gain an additional +35% attack speed and +25% movement speed, but cannot recover life
			Death is inevitable when the timer expires; unequipping or leaving the world cannot erase this debt
			'''
	}

