EndfieldNatural: {
	MaterialTooltip:
		'''
		A precious natural resource. Exchange at a Factory or sell to Closure for Orundum.
		Used to craft Reclamation Algorithm food and practical supplies.
		'''
	WorldGenMessage: Seeding Endfield natural resources...
	AnyFungus: Any Endfield Fungus
	AnyLeaf: Any Endfield Rare Leaf
	AnyStone: Any Endfield Rare Stone
	GatheringButton: Gathering Requests
	GatheringRequest: Doctor, bring me {1} {0}. I will pay {2} Orundum and {4} {3}.
	GatheringThanks: Thanks for the {0}! Your {1} Orundum and {3} {2} have been delivered. Come back for another request.
}
