EndfieldNatural: {
	MaterialTooltip:
		'''
		珍贵自然资源，可在加工站兑换合成玉，也可出售给可露希尔
		可用于生息演算食物及实用道具的制作
		'''
	WorldGenMessage: 播种终末地自然资源…
	AnyFungus: 任意终末地菌类
	AnyLeaf: 任意终末地多齿叶或珍贵叶片
	AnyStone: 任意终末地珍贵矿石
	GatheringButton: 采集委托
	GatheringRequest: 博士，我需要{0}×{1}。带来后给你{2}合成玉，另加{3}×{4}。
	GatheringThanks: 收到这批{0}啦！{1}合成玉和{2}×{3}已经给你。下次来再接一单吧～
}
