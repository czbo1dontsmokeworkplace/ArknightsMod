TerminusLight: {
	DisplayName: 终末光
	Tooltip:
		'''
		在鼠标处凝聚心核与八颗环绕核心，持续伤害接触的敌人
		蓄能结束后，核心依次向附近敌人发射激光，随后心核爆发
		激光无法贯穿敌人
		'''
	FlavorText: “所有可能，都在此收束。”
}

OriginSever: {
	DisplayName: 起源斩
	Tooltip:
		'''
		连续施展下斩、回斩与突刺，挥击留下伤害敌人的赤雾
		每次挥击首次命中敌人时，从其上下方召来追踪血光
		最后一击威力更高，并短暂束缚普通敌人；首领只承受持续伤害
		'''
	FlavorText: “最初的裂痕，亦是生长的方向。”
}

RushingEnd: {
	DisplayName: 血光之灾
	Tooltip:
		'''
		消耗凝胶，喷射不断膨胀并减速停留的源生晶尘
		每次喷射三股随机方向的晶尘，可反复贯穿敌人并穿过地形
		'''
	FlavorText: “血光奔涌，生命于此终结。”
}

NestOfLife: {
	DisplayName: 生之巢
	Tooltip:
		'''
		召唤源石畸变体，占用2格仆从栏
		畸变体以近身斩击、冲刺与追踪孢子交替进攻
		右键指定优先攻击目标
		'''
	FlavorText: “毁灭的残骸，孕育新的守护。”
}
