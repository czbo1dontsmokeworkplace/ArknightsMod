StatusMessage: {
	IACT: {
		Intro: 检测到未经许可擅自闯入禁区的实体，标记为打击目标
		Summon: 你感受到了来自帝国的威胁...
		Summon2: 发现可疑目标，予以抹除
		Stage1to2: 目标强度高于预测强度，调用高阶权限实施打击
		Stage2to3: 目标强度过高，调用最终权限实施打击
		Stage2: 估算目标运动趋势，实施精确打击
		Stage3: 已获得最高权限，启动多功能辅助系统
		End: 检测到主结构严重损毁，启动自毁模式...
		Complete: 来自帝国的轰炸无人机已被击毁...
	}

	UpdateClosureShop: 可露希尔时装商店已更新，快去看看吧
	AACT.Collapsed: "{0}坍缩了"
	FN.AllFloorBanned: "{0}没有留意到自己已无立足之地"
	Pmp.GetTooClose: "{0}站在了喷发的活火山口上"
}

Items: {
	EvolutionSummon: {
		DisplayName: 异变培养皿
		Tooltip:
			'''
			召唤“进化的本质”
			需要击败全部机械三王；不限时间与群系
			第一阶段将封锁周围区域，请在开阔场地使用
			不消耗
			'''
	}

	EvolutionOrigin: {
		DisplayName: 进化的起点
		Tooltip:
			'''
			+6防御、+40最大生命值、+5%伤害减免
			没有大型Boss存活时，每击杀一个敌人获得1层进化，最多25层
			事件Boss和小Boss不阻止叠层
			每层提供+0.4防御、+0.25%伤害、+0.15%暴击率和+0.2%移动速度
			20秒未击杀敌人后，每秒减少1层；死亡或卸下配饰时清空
			'''
	}

	EvolutionTerminus: {
		DisplayName: 进化的终点
		Tooltip:
			'''
			+10%伤害、+8%暴击率、+8%攻击速度、+10%移动速度
			受到致命伤害时，阻止此次死亡并进入10秒濒死形态
			濒死期间完全无敌，额外获得+50%伤害、+30%暴击率
			额外获得+35%攻击速度和+25%移动速度，但无法恢复生命
			10秒后必定死亡；卸下配饰不能解除，退出世界也不会免除死亡
			'''
	}
}

Buffs: {
