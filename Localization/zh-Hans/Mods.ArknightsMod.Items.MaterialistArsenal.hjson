FighterDispatchTerminal: {
	DisplayName: 战机调度终端
	Tooltip:
		'''
		召唤妖怪无人机，占用1格仆从栏
		无人机消耗物品栏中的子弹作战，并保留弹种效果；没有子弹时停止射击
		无人机及其弹药造成召唤伤害；右键指定优先攻击目标
		'''
}

MiniGatling: {
	DisplayName: 迷你加特林
	Tooltip:
		'''
		短暂启动后，持续向鼠标方向倾泻机枪弹流
		将子弹转化为高速直射曳光弹，不追踪敌人
		'''
}

OrbitalLaser: {
	DisplayName: 轨道激光
	Tooltip:
		'''
		标记鼠标位置，短暂蓄能后从高空降下三束激光
		激光贯穿沿途敌人，受实心方块阻挡
		'''
}

RotorBladeCraft: {
	DisplayName: 旋刃飞行器
	Tooltip:
		'''
		投出自动返回的旋刃飞盘，持续向附近敌人发射激光
		飞盘与激光均可穿墙，飞盘本体不造成接触伤害
		每8帧向附近敌人发射近战激光，无目标时不开火
		'''
}
