FighterDispatchTerminal: {
	DisplayName: 无人机调度终端
	Tooltip:
		'''
		召唤妖怪无人机为你作战
		无人机消耗你的子弹
		'''
}

MiniGatling: {
	DisplayName: 迷你加特林
	Tooltip: 短暂启动后，向敌人持续倾泻大量高速机枪弹
}

PlasmaProjector: {
	DisplayName: 等离子投射器
	Tooltip:
		'''
		按住左键持续发射蓝色双束等离子激光
		每束固定长60格，可无限贯穿敌人和地形，每8帧造成一次伤害
		每束独立计算：每贯穿随机2～4名敌人，后续伤害再乘随机80%～90%
		每轮伤害重新计算衰减，持续开火不会降低首个目标受到的伤害
		持续消耗魔力，松开左键停止攻击
		'''
}

OrbitalLaser: {
	DisplayName: 轨道激光
	Tooltip: 释放智能标记，短暂蓄能后从天而降三道激光
}

RotorBladeCraft: {
	DisplayName: 旋刃飞行器
	Tooltip: 丢出智能回旋飞盘，持续向敌人倾泻激光
}
