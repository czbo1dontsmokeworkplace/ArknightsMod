		'''
}

TheLongWhipOfTheCoachman: {
	DisplayName: 赶车夫的长鞭
	Tooltip:
		'''
		所有敌方单位受到的近战和远程伤害[c/3791db:+15%]
		作为剧团的赶车人，他没有名字，没有过往
