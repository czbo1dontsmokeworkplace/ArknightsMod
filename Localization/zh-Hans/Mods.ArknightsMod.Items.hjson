		'''
}

ChildlikePlaythings: {
	DisplayName: “童趣玩偶”
	Tooltip:
		'''
		当敌人带有以下任意一种debuff时，每秒受到100点无来源伤害：
		[c/FF6A6A:着火了！]
		[c/FF6A6A:中毒]
		[c/FF6A6A:诅咒狱火]
		伊比利亚的孩童们将海岸边的奇物做成了简陋玩偶，听说只要抱着它，梦乡就会变得充实起来
		'''
}

DamagedRevolverNest: {
	DisplayName: 损坏的左轮弹巢
	Tooltip:
		'''
		远程武器攻击力[c/3791db:+35%]
		她行过刀山火海也不曾有一刻向奸邪低头，她枪口火舌焦灼好似怒阳，她头顶光芒炽烈几胜白昼
		此处安葬着Outcast，我们的朋友
		'''
}

DreamEssence: {
	DisplayName: 迷梦香精
	Tooltip:
		'''
		所有自然回复技能的技力恢复[c/3791db:+0.5]/秒
		据说女妖们制作的香氛只会送给心上之人
		只需一滴，就能令人如痴如醉，而艺术家们的灵感与创意也随之而来
		'''
}

FearlessBlade: {
	DisplayName: 无惧之刃
	Tooltip:
		'''
		背包内稀有度最高的武器[c/3791db:+20%]伤害
		装备栏以及背包内稀有度最高的一件、能提供防御力加成的饰品，额外提供[c/3791db:50%]防御力
		他站在城门前，为卡兹戴尔守住这处门户
		高卢火炮队、莱塔尼亚术师团、维多利亚骑士轮番上阵，想要突破这只有一名萨卡兹的防线
		可直到城门被轰碎，直到联军决定撤退，这位歌利亚剑士都没有后退一步
		'''
}

OldPalmFan: {
	DisplayName: 老蒲扇
	Tooltip:
		'''
		当前世界中，每存在一名城镇NPC，玩家的攻击力[c/3791db:+3%]
		遇上连天阴雨，大炎的老天师便会向亲友抱怨自己膝盖受不得湿寒，然后，随手扇动他的蒲扇...
		云开雾散，雨水退避，天气就此放晴这一手，下回还得教教他那在大理寺当差的小徒弟
		'''
}

RoundStoneAltar: {
