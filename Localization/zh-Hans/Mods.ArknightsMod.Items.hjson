		'''
}

SuspendedSilkPuppet: {
	DisplayName: 悬丝傀儡
	Tooltip:
		'''
		当敌人带有以下任意一种debuff时，每秒受到70点无来源伤害：
		[c/FF6A6A:诅咒狱火]
		[c/FF6A6A:着火了！]
		[c/FF6A6A:中毒]
