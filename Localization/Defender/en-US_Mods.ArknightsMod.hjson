DefenderRecipeGroup: Beagle or Cardigan shield

Items: {
	FirewhistleLauncher: {
		DisplayName: Grenade Shield [Firewhistle]
		Tooltip:
			'''
			Consumes 1 Grenade per shot, dealing ranged area damage
			Shells fall under stronger gravity; guarding grants 50% DEF and 50% damage reduction while allowing fire
			'''
	}

	LiskarmPistol: {
		DisplayName: Shock Pistol and Shield [Liskarm]
		Tooltip:
			'''
			Fires fast electron rounds dealing ranged magic damage without consuming bullets
			During skill 2, rounds discharge on impact and damage nearby groups
			'''
	}

	CroissantHammer: {
		DisplayName: Hammer and Shield [Croissant]
		Tooltip: Swing a heavy hammer; hits release area shockwaves during skill 2
	}

	MudrockHammer: {
		DisplayName: Earthshaker Hammer [Mudrock]
		Tooltip:
			'''
			Hammer hits restore 2% maximum life, at most once per second
			Skill 2 empowers shockwaves and healing; skill 3 greatly boosts offense and defense
			'''
	}

	EunectesAxe: {
		DisplayName: Jungle Great Axe [Eunectes]
		Tooltip:
			'''
			Left-click to swing; right-click to charge toward the cursor for 400% attack damage
			Rebound on enemy or wall impact; fully immune to damage during the charge
			Charge cooldown: 1.5 seconds; replaces shield guarding
			'''
	}
}

