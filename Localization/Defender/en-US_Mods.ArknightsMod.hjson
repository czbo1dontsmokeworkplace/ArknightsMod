DefenderRecipeGroup: Beagle or Cardigan shield

Items: {
	FirewhistleLauncher: {
		DisplayName: Grenade Shield [Firewhistle]
		Tooltip: Pre-Hardmode Fortress weapon. Consumes 1 Grenade per shot; strong shell gravity and 75-pixel blast radius. Wildfire empowers one shell; Scorched Earth leaves burning fields. Can fire while guarding.
	}

	LiskarmPistol: {
		DisplayName: Shock Pistol and Shield [Liskarm]
		Tooltip: Fires electronic Arts rounds without ammo. Taking damage restores 1 SP; Defensive Charge blocks one hit and Counter Arc releases area discharges.
	}

	CroissantHammer: {
		DisplayName: Hammer and Shield [Croissant]
		Tooltip: Retains hammer swings; Automatic Defense boosts DEF and Magnetic Hammer strengthens attacks and area impacts.
	}

	MudrockHammer: {
		DisplayName: Earthshaker Hammer [Mudrock]
		Tooltip: Contact healing; Crag Splitter boosts area shocks and recovery; S3 prepares for 3s before empowered combat.
	}

	EunectesAxe: {
		DisplayName: Jungle Great Axe [Eunectes]
		Tooltip: Left-click swings; right-click dashes toward the cursor for 400% ATK with a bounce. Invulnerable during collision dash; 1.5s cooldown. Skills boost offense, defense or recovery.
	}
}

Skills: {
	FirewhistleLauncher: {
		1: {
			Label: Wildfire
			Desc: The next shell deals 185% ATK and ignites targets for 4s. Activates on firing when charged; armed for up to 30s.
		}

		2: {
			Label: Scorched Earth
			Desc: 17s: shells leave 6s burning fields, dealing Arts damage equal to 85% ATK each second. Shell explosions retain ranged damage.
		}
	}

	LiskarmPistol: {
		1: {
			Label: Defensive Charge
			Desc: 8s: DEF +100%; blocks the next enemy hit. Taking damage while holding the weapon restores 1 SP.
