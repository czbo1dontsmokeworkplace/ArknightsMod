	CatapultLauncher: {
		DisplayName: Grenade Launcher [Catapult]
		Tooltip:
			'''
			Launches grenades high into the air to fall and explode over the target
			Requires no ammunition and does not destroy terrain
			'''
	}
}

Skills: {
	CatapultLauncher: {
		1: {
			Label: Blast Range Up α
			Desc:
				'''
				Auto recovery, manual activation; increases blast radius without increasing damage
				Levels 1–3: 150% radius; levels 4–6: 175%; level 7: 200%
				SP cost at levels 1–7: 55 / 53 / 51 / 50 / 48 / 46 / 45
				Duration in seconds: 20 / 22 / 24 / 25 / 27 / 29 / 30
				Level 7: 45 SP, 30 seconds, 280-pixel blast radius
				'''
		}
	}
}

