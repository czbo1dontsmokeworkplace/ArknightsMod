Items: {
	CatapultLauncher: {
		DisplayName: 榴弹发射器 [空爆]
		Tooltip:
			'''
			向高空发射榴弹，从目标上方落下并爆炸
			不消耗弹药，不会破坏地形
			'''
	}
}

Skills: {
	CatapultLauncher: {
		1: {
			Label: 爆破范围提升·α型
			Desc:
				'''
				自动回复，手动开启；只扩大爆炸范围，不增加伤害
				1—3级：爆炸半径提升至150%；4—6级：175%；7级：200%
				1—7级消耗技力：55／53／51／50／48／46／45
				对应持续时间：20／22／24／25／27／29／30秒
				7级：45技力、持续30秒、爆炸半径280像素
				'''
		}
	}
}

