CatapultText: {
	SkillKey: 按[{0}]开启技能
	Unbound: 请在控制设置中绑定“技能开启”键
	Placeholder: 武器贴图暂借原版榴弹发射器，技能图标暂借陨星
}

Items: {
	CatapultLauncher: {
		DisplayName: 榴弹发射器 [空爆]
		Tooltip:
			'''
			向高空发射火箭弹，再从鼠标上方落下，最远650像素
			炮弹碰到敌人、实心方块或抵达落点时爆炸
			下落阶段爆炸伤害提高25%，不会破坏地形
			基础爆炸半径140像素，不消耗弹药
			骷髅王后可制作
			'''
	}
}

Skills: {
	CatapultLauncher: {
		1: {
			Label: 爆破范围提升·α型
			Desc:
				'''
				自动回复，手动开启；只扩大爆炸范围，不增加伤害
				1—3级：爆炸半径提升至150%；4—6级：175%；7级：200%
				1—7级消耗技力：55／53／51／50／48／46／45
				对应持续时间：20／22／24／25／27／29／30秒
				7级：45技力、持续30秒、爆炸半径280像素
				'''
		}
	}
}

Projectiles: {
	CatapultHoldout.DisplayName: 空爆的榴弹发射器
	CatapultShell.DisplayName: 空爆榴弹
