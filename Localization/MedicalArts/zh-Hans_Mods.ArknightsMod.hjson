BranchTraits: {
	MedicProfession: 医疗：  武器可以高效治疗我方单位，但代价是无法对敌人造成伤害
	MedicTherapist: 疗养师：  基础治疗量更低，但具备追踪能力
	MedicMultiTarget: 群愈师：  基础治疗量约为同阶段普通医疗的66%；按住左键1秒，在光标范围内治疗友方一次
	MedicChain: 链愈师：  成功治疗后附加可叠层的持续生命回复
	MedicWandering: 行医：  直接清除身上的负面状态；单次清除的负面状态越多，额外治疗量越高
}

MedicalArts: {
	Shorten: 每次命中缩短每种可净化负面状态的剩余时间；基础缩短 {0:0.##} 秒，随治疗攻击力强化；不影响药水冷却、抗药病或战斗机制状态
	Numbers:
		'''
		治疗量 {0}（基础 {5}，受魔法伤害加成）；施法间隔 {1:0.##} 秒；生效延迟 {2:0.##} 秒
		成功治疗后抗药病持续 {3:0.##} 秒，医疗效果削减 {4:0}%；无效接触不会刷新
		'''
	Regen: 最多 {0} 层，每层每秒回复 {1:0.##} 点生命，独立持续 {2} 秒；已有层数不受抗药病削减
	Cleanse: 最多净化 {0} 种常见战斗减益；无法清除抗药病、药水冷却或战斗机制状态
	Gate1: 击败世界吞噬怪或克苏鲁之脑后
	Gate2: 进入困难模式后
	Gate3: 击败任意一个机械首领后
	Gate4: 击败全部三个机械首领后
	Gate5: 击败世纪之花后
	Gate6: 击败拜月教邪教徒后
}

Buffs: {
	MedicationSickness: {
		DisplayName: 抗药病
		Description: 医疗干员武器的直接治疗效果降低；已有持续回复仍然生效
	}

	MedicalRejuvenation: {
		DisplayName: 生命编织
		Description: 多层医疗生命回复正在生效，各层独立计时
	}
}
