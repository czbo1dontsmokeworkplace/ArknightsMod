Items: {
	AutoMedicalPack: {
		DisplayName: 自动医疗包
		Tooltip:
			'''
			受伤时自动从快捷栏左侧开始寻找可用的医疗干员武器，按武器各自的鼠标指向弹道施放一次
			不切换快捷栏，不打断当前武器；仍消耗魔力，所有治疗武器共用3秒冷却
			治疗量受魔法伤害加成，魔力不足时等待恢复；仅佩戴时生效
			'''
	}

	HibiscusStaff: {
		DisplayName: 生命法杖 [芙蓉]
		Tooltip:
			'''
			朝鼠标方向抛出医疗术体，受重力影响，碰到方块可反弹一次
			术体生成后的前10帧无法治疗；所有治疗武器共用3秒冷却
			'''
	}

	NowellStaff: {
		DisplayName: 澄明法杖 [诺威尔]
		Tooltip:
			'''
			从鼠标上方高空召唤医疗术体，先垂直下落，再追踪受伤的友方玩家
			基础治疗量更低，命中同时缩短可净化负面状态的持续时间
			'''
	}

