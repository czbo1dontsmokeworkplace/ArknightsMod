Items: {
	HibiscusStaff: {
		DisplayName: 生命法杖 [芙蓉]
		Tooltip:
			'''
			放出五瓣星状生命光，沿轻柔曲线转向伤员
			向上抛出后可自行接取，术体需要短暂时间才能生效
			'''
	}

	NowellStaff: {
		DisplayName: 澄明法杖 [诺威尔]
		Tooltip:
			'''
			送出双重水光，下落后校正方向追踪伤员
			治疗同时缩短可净化负面状态的持续时间
			'''
	}

	AnselStaff: {
		DisplayName: 医疗法杖 [安赛尔]
		Tooltip:
			'''
			发射粉色救援彗光，快速直射后折返寻找伤员
			向上抛出后可自行接取，术体需要短暂时间才能生效
			'''
	}

	MyrrhStaff: {
		DisplayName: 药剂法杖 [末药]
		Tooltip:
			'''
			抛出琥珀药液光团，碰到地形可弹跳一次
			向上抛出后可自行接取，术体需要短暂时间才能生效
			'''
	}

	SussurroStaff: {
		DisplayName: 医疗法杖 [苏苏洛]
		Tooltip:
			'''
			射出高速三联针流，短程飞行后转向伤员
			向上抛出后可自行接取，术体需要短暂时间才能生效
			'''
	}

	SilenceStaff: {
		DisplayName: 医疗法杖 [赫默]
		Tooltip:
			'''
			放出羽状医疗光簇，短暂飞行后转向伤员
			向上抛出后可自行接取，术体需要短暂时间才能生效
			'''
	}

	TuyeStaff: {
		DisplayName: 急救法杖 [图耶]
		Tooltip:
			'''
			发射六边形储液盾，减速蓄压后转向伤员
			向上抛出后可自行接取，术体需要短暂时间才能生效
			'''
	}

	ShiningStaff: {
		DisplayName: 法杖 [闪灵]
		Tooltip:
			'''
			挥出黑纱薄光包裹的银白尖芒，加速飞行后转向伤员
			向上抛出后可自行接取，术体需要短暂时间才能生效
			'''
	}

	PurestreamStaff: {
		DisplayName: 净水法杖 [清流]
		Tooltip:
			'''
			送出流动水光，下落后沿涟漪曲线追踪伤员
			治疗同时缩短可净化负面状态的持续时间
			'''
	}

	CeylonStaff: {
		DisplayName: 雨露法杖 [锡兰]
		Tooltip:
			'''
			展开扇状水光，下落后旋弯追踪伤员
			治疗同时缩短可净化负面状态的持续时间
			'''
	}

	WhisperainStaff: {
		DisplayName: 雾疗法杖 [絮雨]
		Tooltip:
			'''
			送出雨幕辉光，缓缓下落并散落细小光滴
			治疗同时缩短可净化负面状态的持续时间
			'''
	}

	LumenStaff: {
		DisplayName: 引灯法杖 [流明]
		Tooltip:
			'''
			放出蓝金灯火，下落后快速追踪伤员
			治疗同时缩短可净化负面状态的持续时间
			'''
	}

	PerfumerStaff: {
		DisplayName: 芳息法杖 [调香师]
		Tooltip:
			'''
			抛出香水瓶，落点展开六瓣花香治疗场
			区域持续治疗其中的友方玩家
			'''
	}

	BreezeStaff: {
		DisplayName: 疗愈法杖 [微风]
		Tooltip:
			'''
			送出旋转风轮，弧线落地后展开旋风治疗场
			区域持续治疗其中的友方玩家
			'''
	}

	PtilopsisStaff: {
		DisplayName: 医疗法杖 [白面鸮]
		Tooltip:
			'''
			发射银蓝数据光束，减速落地后展开碎光治疗场
			区域持续治疗其中的友方玩家
			'''
	}

	NightingaleStaff: {
		DisplayName: 圣域法杖 [夜莺]
		Tooltip:
			'''
			放出柔羽光幕，飘落后展开柔光庇护治疗场
			区域持续治疗其中的友方玩家
			'''
	}

	PapyrusStaff: {
		DisplayName: 织愈法杖 [莎草]
		Tooltip:
			'''
			送出金色穗状光流，滑翔转弯并留下再生微光
			治疗附加可叠加的持续回复，每层独立计时
			'''
	}

	PaprikaStaff: {
		DisplayName: 续生法杖 [明椒]
		Tooltip:
			'''
			送出粉红螺旋火光，弯曲追踪并留下再生微光
			治疗附加可叠加的持续回复，每层独立计时
			'''
	}

	Mon3trCore: {
		DisplayName: 共生核心 [Mon3tr]
		Tooltip:
			'''
			射出翡翠棱光，高速转向伤员并散落再生碎光
			治疗附加可叠加的持续回复，每层独立计时
			'''
	}

	ChestnutStaff: {
		DisplayName: 净疗法杖 [褐果]
		Tooltip:
			'''
			送出旋转叶状光斑，以螺旋轨迹输送净化治疗
			每清除一种减益，本次治疗量额外提高35%
			'''
	}

	HoneyberryStaff: {
		DisplayName: 草药法杖 [蜜莓]
		Tooltip:
			'''
			送出双核莓色微光，摇曳转向并提供净化治疗
			每清除一种减益，本次治疗量额外提高35%
			'''
	}

	MulberryStaff: {
		DisplayName: 祛厄法杖 [桑葚]
		Tooltip:
			'''
			送出蓝色净化绸光，分段修正方向追踪伤员
			每清除一种减益，本次治疗量额外提高35%
			'''
	}

	EyjafjallaAlterStaff: {
		DisplayName: 温泉法杖 [纯烬艾雅法拉]
		Tooltip:
			'''
			放出漂浮的粉色泡沫辉光，缓慢转向伤员并提供净化治疗
			每清除一种减益，本次治疗量额外提高35%
			'''
	}

	WarfarinStaff: {
		DisplayName: 血浆法杖 [华法琳]
		Tooltip:
			'''
			送出猩红血雾旋流，蜿蜒追踪伤员并输送治疗
			术体生成后的前10帧无法治疗，会穿过玩家；向上抛出后走位接取
			'''
	}
}

