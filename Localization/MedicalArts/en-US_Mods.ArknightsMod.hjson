Items: {
	AutoMedicalPack: {
		DisplayName: Automatic Medical Pack
		Tooltip:
			'''
			While injured, automatically casts the first available Medic weapon in your hotbar toward the cursor using its branch trajectory
			Does not switch slots or interrupt your weapon; costs mana and shares the fixed 3-second medical cooldown
			Healing scales with magic damage; waits when mana is insufficient; must be equipped
			'''
	}

	HibiscusStaff: {
		DisplayName: Life Staff [Hibiscus]
		Tooltip:
			'''
			Throws a healing art toward the cursor, affected by gravity and able to bounce once off tiles
			Cannot heal during its first 10 frames; all healing weapons share a 3-second cooldown
			'''
	}

	NowellStaff: {
		DisplayName: Clarity Staff [Nowell]
		Tooltip:
			'''
			Calls a healing art from above the cursor; falls straight down before homing toward an injured ally
			Lower base healing; hits also shorten removable debuffs
			'''
	}

