BranchTraits: {
	MedicProfession: Medic:  These weapons efficiently heal allies, at the cost of being unable to damage enemies
	MedicTherapist: Therapist:  Lower base healing, but healing arts can home
	MedicMultiTarget: Multi-target Medic:  Base healing is approximately 66% of a normal Medic at the same progression stage; landing or contact creates a persistent healing field for allied players inside
	MedicChain: Chain Medic:  Successful healing adds independently expiring stacks of life regeneration
	MedicWandering: Wandering Medic:  Cleanse removable debuffs; each debuff removed increases healing
}

MedicalArts: {
	Shorten: Each hit shortens every removable debuff; base reduction {0:0.##}s, scaling with medical attack power; excludes potion cooldowns, medication resistance and encounter mechanics
	Numbers:
		'''
		Healing: {0} (base {5}, scales with magic damage); cast interval: {1:0.##}s; arming delay: {2:0.##}s
		Successful healing applies {3:0.##}s of {4:0}% medication resistance; failed contacts do not refresh it
		'''
	Regen: Up to {0} stacks; each restores {1:0.##} life/s for {2}s independently; existing regeneration continues during resistance
	Cleanse: Cleanses up to {0} common combat debuffs; cannot remove medication resistance, potion cooldowns or encounter mechanics
	Gate1: After defeating the Eater of Worlds or Brain of Cthulhu
	Gate2: In Hardmode
	Gate3: After defeating any mechanical boss
	Gate4: After defeating all three mechanical bosses
	Gate5: After defeating Plantera
	Gate6: After defeating the Lunatic Cultist
}

Buffs: {
	MedicationSickness: {
		DisplayName: Medication Resistance
		Description: Direct healing from medical operator weapons is reduced; existing regeneration continues
	}

	MedicalRejuvenation: {
		DisplayName: Woven Life
		Description: Stacking medical life regeneration; each layer expires independently
	}
}
