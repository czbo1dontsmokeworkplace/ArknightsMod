Skills: {
	CorroserumFlamethrower: {
		1: {
			Label: 专注力超载
			Desc: 手动开启，喷射伤害提高35%至80%。
		}

		2: {
			Label: 净浊焰流
			Desc: 手动开启，喷射伤害提高15%至50%，命中额外施加3秒灵液，削弱敌人防御。
		}
	}

	IfritFlamethrower: {
		1: {
			Label: 狂热
			Desc: 手动开启，喷射伤害提高15%至40%，喷射频率提高30%至50%。
		}

		2: {
			Label: 炎爆
			Desc: 自动强化下一次喷射，造成220%至300%伤害；光束宽度与碰撞尺寸提高至150%，飞行速度保持不变。首个命中点引爆直径96像素的火团，造成该次喷射50%的伤害。可储存3次。
		}

		3: {
			Label: 灼地
			Desc: 手动开启，喷射伤害提高50%至110%，命中施加3秒涂油。火焰无法穿透方块，撞击后在方块表面附着持续1秒的火焰；同一表面重复命中刷新持续时间。附着火焰半径48像素，每30帧造成该次喷射三分之一的伤害。
		}
	}

	AphrissaProjector: {
		1: {
			Label: 连续映射
			Desc: 手动开启，火焰伤害提高30%至70%，基础总射程由1248像素提高至1680像素。
		}

		2: {
			Label: 折光脉冲
			Desc: 自动强化下一次喷射，造成200%至300%伤害，并扩大火焰宽度。可储存3次。
		}

		3: {
			Label: 混沌的本质
			Desc: 手动开启，火焰伤害提高50%至100%，喷射频率提高50%，命中额外施加3秒灵液。
		}
	}
}
