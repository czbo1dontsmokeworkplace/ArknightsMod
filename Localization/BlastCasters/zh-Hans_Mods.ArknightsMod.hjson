Items: {
	CorroserumFlamethrower: {
		DisplayName: 净浊喷火器 [蚀清]
		Tooltip:
			'''
			困难模式初期
			按住左键持续喷射单股直线光焰，可穿透方块并无限贯穿敌人，命中施加20秒狱炎与诅咒狱火
			使用凝胶；每3次喷射尝试消耗1个凝胶，并享受弹药节省效果
			受射手装备加成，在本模组的抗性系统中视为法术伤害
			'''
	}

	IfritFlamethrower: {
		DisplayName: 焚灭喷火器 [伊芙利特]
		Tooltip:
			'''
			世纪之花后
			按住左键持续喷射单股直线高热光焰，可穿透方块并无限贯穿敌人，命中施加20秒狱炎
			使用凝胶；每3次喷射尝试消耗1个凝胶，并享受弹药节省效果
			受射手装备加成，在本模组的抗性系统中视为法术伤害
			'''
	}

	AphrissaProjector: {
		DisplayName: 折光喷射器 [谬因]
		Tooltip:
			'''
			四柱时期
			按住左键持续喷射单股直线高速光焰，无限贯穿敌人并施加5秒狱炎
			弹幕沿路径飞行并穿透方块，基础总射程1248像素；达到总射程后停止伤害并消散
			右键在光标处放置或移动一个中继器，再右键中继器可将其撤回
			有有效中继器时，枪口朝其喷射，光学弹幕抵达后转向发射时的光标位置，并延长320像素总射程
			中继器可在560像素内的空地放置并隔墙连接，持续20秒；超过720像素、切换武器或死亡后消失
			使用凝胶；每3次喷射尝试消耗1个凝胶，并享受弹药节省效果
			受射手装备加成，在本模组的抗性系统中视为法术伤害
			'''
	}
}

