			喷射穿墙光焰，命中施加狱炎与诅咒狱火
			消耗凝胶，受远程伤害加成
			'''
	}

	IfritFlamethrower: {
		DisplayName: 焚灭喷火器 [伊芙利特]
		Tooltip:
			'''
			喷射穿墙高热光焰，命中施加狱炎
			消耗凝胶，受远程伤害加成
			'''
	}

	AphrissaProjector: {
		DisplayName: 折光喷射器 [谬因]
		Tooltip:
			'''
			喷射穿墙能量束，命中施加狱炎
			消耗凝胶，受远程伤害加成
			'''
	}
}

