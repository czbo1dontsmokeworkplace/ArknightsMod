Items: {
	CorroserumFlamethrower: {
		DisplayName: Purification Flamethrower [Corroserum]
		Tooltip:
			'''
			Early Hardmode
			Hold left-click to spray a single straight lightflame stream through blocks and unlimited enemies, inflicting Hellfire and Cursed Inferno for 20 seconds
			Uses gel; attempts to consume one gel per 3 emissions and benefits from ammo conservation
			Scales with ranged equipment; counts as Arts damage in this mod's resistance system
			'''
	}

	IfritFlamethrower: {
		DisplayName: Incineration Flamethrower [Ifrit]
		Tooltip:
			'''
			Post-Plantera
			Hold left-click to spray a single straight searing lightflame stream through blocks and unlimited enemies, inflicting Hellfire for 20 seconds
			Uses gel; attempts to consume one gel per 3 emissions and benefits from ammo conservation
			Scales with ranged equipment; counts as Arts damage in this mod's resistance system
			'''
	}

	AphrissaProjector: {
		DisplayName: Refraction Projector [Aphrissa]
		Tooltip:
			'''
			Lunar events
			Hold left-click to spray a single straight high-speed lightflame stream with unlimited enemy piercing, inflicting Hellfire for 5 seconds
			Packets physically travel through blocks, with a base total range of 1248 pixels; reaching that range stops damage and dissolves the trail
			Right-click to place or move one relay at the cursor; right-click the relay to remove it
			With a valid relay, the gun fires toward it; arriving packets turn toward the cursor position captured when fired, gaining 320 pixels of total range
			Place in open space within 560 pixels, including beyond walls; lasts 20 seconds and vanishes beyond 720 pixels, on weapon switch or death
			Uses gel; attempts to consume one gel per 3 emissions and benefits from ammo conservation
			Scales with ranged equipment; counts as Arts damage in this mod's resistance system
			'''
	}
}

