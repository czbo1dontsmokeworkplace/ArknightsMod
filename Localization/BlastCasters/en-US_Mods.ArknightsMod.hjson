Items: {
	CorroserumFlamethrower: {
		DisplayName: Purification Flamethrower [Corroserum]
		Tooltip:
			'''
			Sprays a continuous flame that passes through terrain and inflicts Hellfire and Cursed Inferno
			Uses gel; scales with ranged damage and counts as Arts damage against resistances
			'''
	}

	IfritFlamethrower: {
		DisplayName: Incineration Flamethrower [Ifrit]
		Tooltip:
			'''
			Sprays a continuous high-temperature flame that passes through terrain and inflicts Hellfire
			Uses gel; scales with ranged damage and counts as Arts damage against resistances
			'''
	}

	AphrissaProjector: {
		DisplayName: Refraction Projector [Aphrissa]
		Tooltip:
			'''
			Sprays swift flames that pass through terrain and inflict Hellfire
			Right-click to place or move a relay that redirects flames toward the cursor and extends their range; right-click the relay to recall it
			The relay lasts 20 seconds and vanishes if you move too far away or switch weapons
			Uses gel; scales with ranged damage and counts as Arts damage against resistances
			'''
	}
}

