Items: {
	CorroserumFlamethrower: {
		DisplayName: Purification Flamethrower [Corroserum]
		Tooltip:
			'''
			Sprays terrain-piercing flames that inflict Hellfire and Cursed Inferno
			Uses gel; scales with ranged damage
			'''
	}

	IfritFlamethrower: {
		DisplayName: Incineration Flamethrower [Ifrit]
		Tooltip:
			'''
			Sprays terrain-piercing superheated flames that inflict Hellfire
			Uses gel; scales with ranged damage
			'''
	}

	AphrissaProjector: {
		DisplayName: Refraction Projector [Aphrissa]
		Tooltip:
			'''
			Projects a terrain-piercing energy beam that inflicts Hellfire
			Uses gel; scales with ranged damage
			'''
	}
}

