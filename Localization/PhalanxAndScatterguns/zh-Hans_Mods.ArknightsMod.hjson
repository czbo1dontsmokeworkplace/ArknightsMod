			Desc: 持续12秒：伤害提高35%，霰弹忽略35点防御
		}

		2: {
			Label: 最终旅程
			Desc: 持续12秒：射速提高75%，以连续重霰弹压制敌人
		}
	}

	ChalterWatergun: {
		1: {
			Label: 高压冲洗
			Desc: 持续12秒：伤害提高35%，水流使命中敌人减速；首领不受减速影响
		}

		2: {
			Label: 假日风暴
			Desc: 持续16秒：伤害提高35%，命中产生持续3秒的减速水域，最多3片；水域每30帧造成20%伤害，重叠不叠加
		}
