Items: {
	BeeswaxStaff: {
		DisplayName: 蜜蜡的守砂法杖
		Tooltip:
			'''
			默认展开砂金护盾，抵挡3次攻击
			持续按住左键收起护盾，蓄力90帧后释放猛烈冲击波
			松手或切换武器取消蓄力，持续按住可反复蓄力释放
			护盾平滑显隐，单次抵挡不受伤害大小限制
			破盾释放250%伤害的强化冲击波
			连续5秒未受伤后，每2秒恢复一层
			三把阵法法杖共用护盾消耗记录，切换与重进不会补满
			'''
	}

	CarnelianStaff: {
		DisplayName: 卡涅利安的赤砂法杖
		Tooltip:
			'''
			默认展开赤金护盾，抵挡4次攻击
			持续按住左键收起护盾，蓄力90帧后释放猛烈冲击波
			松手或切换武器取消蓄力，持续按住可反复蓄力释放
			护盾平滑显隐，单次抵挡不受伤害大小限制
			破盾释放250%伤害的强化冲击波
			连续5秒未受伤后，每2秒恢复一层
			三把阵法法杖共用护盾消耗记录，切换与重进不会补满
			'''
	}

	LinStaff: {
		DisplayName: 林的琉璃法杖
		Tooltip:
			'''
			默认展开琉璃护盾，抵挡5次攻击
			持续按住左键收起护盾，蓄力90帧后释放猛烈冲击波
			松手或切换武器取消蓄力，持续按住可反复蓄力释放
			破盾时额外迸射十二枚琉璃碎片
			护盾平滑显隐，单次抵挡不受伤害大小限制
			破盾释放250%伤害的强化冲击波
			连续5秒未受伤后，每2秒恢复一层
			三把阵法法杖共用护盾消耗记录，切换与重进不会补满
			'''
	}

	PineconeNailgun: {
		DisplayName: 松果的射钉枪
		Tooltip:
			'''
			消耗一发子弹射出5枚钢钉
			钢钉扎入敌人后延时爆炸
			站立不动时获得更高的散射精度
			'''
	}

	ExecutorShotgun: {
		DisplayName: 送葬人的霰弹枪
		Tooltip:
			'''
			快速喷射两轮可穿透敌人的霰弹
			近距离具有更高杀伤和穿甲能力
			站立不动时获得更高的散射精度
			'''
	}

	ChalterWatergun: {
		DisplayName: 假日威龙陈的高压水枪
		Tooltip:
			'''
			喷射可贯穿5名敌人的散射水滴
			近距离具备更高的伤害
			站立不动时获得更高的散射精度
			'''
	}
}

