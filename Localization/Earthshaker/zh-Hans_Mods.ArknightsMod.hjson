BranchTraits.Earthshaker:
	'''
	撼地者：  按住左键举锤蓄力，松开猛砸；蓄满后沿地面喷出火柱
	右键算作正常锤
	'''

Items: {
	OddaHammer: {
		DisplayName: 奥达的锻锤
		Tooltip:
			'''
			举锤蓄势后猛砸地面，蓄满后向前喷出一连串火柱
			火柱沿地形延伸，攻击前方的敌人
			'''
	}

	ZimaFuryHammer: {
		DisplayName: 怒潮凛冬的震地锤
		Tooltip:
			'''
			举锤蓄势后猛砸地面，蓄满后向前喷出一连串火柱
			火柱沿地形延伸，攻击前方的敌人
			'''
	}

	PepeHammer: {
		DisplayName: 佩佩的时光重锤
		Tooltip:
			'''
			举锤蓄势后猛砸地面，蓄满后向前喷出一连串火柱
			火柱沿地形延伸，攻击前方的敌人
			'''
	}
}

Buffs: {
	EarthshakerStagger: {
		DisplayName: 震荡失衡
		Description: 地火使移动受阻
	}
}

Skills: {
	OddaHammer: {
		1: {
			Label: 火花溅射
			Desc: 近战与地火命中回复技力。充满后自动强化下一次左键，造成140%～240%伤害，地火范围扩大35%。不会改变右键工具挥动。
		}

		2: {
			Label: 锻锤之力
			Desc: 持续18秒，左键攻击力与防御力提高10%～100%。落锤可以震起可击退的小怪。首领与不可击退目标不受浮空影响。
		}
	}

	ZimaFuryHammer: {
		1: {
			Label: 誓不低头
			Desc: 持续30秒，左键攻击力提高25%～50%，举锤蓄力加快，地火范围扩大10%，对可控制小怪施加短暂减速。
		}

		2: {
			Label: 绝不罢休
			Desc: 持续30秒，左键攻击力提高45%～90%，防御力提高30%～60%，地火范围扩大10%，震荡使可控制小怪短暂减速。
		}

		3: {
			Label: 无可抵挡
			Desc: 持续12秒，左键攻击力提高50%～120%，每次落锤后再增加20%；地火范围扩大35%，每次蓄满落锤产生五轮地火，后续每轮伤害依次提高10%。
		}
	}

	PepeHammer: {
		1: {
			Label: 盖戳！
			Desc: 技力充满后，下一次左键造成160%～290%伤害，地火范围扩大35%。不改变右键工具挥动。
		}

		2: {
			Label: 阻遏混乱锤
			Desc: 持续18秒，左键攻击力提高50%～90%，地火范围扩大15%，举锤蓄力加快。重复开启会进一步缩短起手，最多叠加两次。
		}

		3: {
			Label: 时光震荡
			Desc: 持续40秒，左键攻击力提高120%～240%；每次落锤额外提高10%～25%攻击力并扩大18%地火范围，至多4层。地火短暂减速可控制小怪，首领不受控制。
		}
	}
}
