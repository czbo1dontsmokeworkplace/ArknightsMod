Items: {
	NightmareStaff: {
		DisplayName: Dream Staff [Nightmare]
		Tooltip: Fires three dreamflames in a straight-line burst
	}

	AbsintheStaff: {
		DisplayName: Enforcement Staff [Absinthe]
		Tooltip: Fires three green Arts needles in a burst, dealing more damage to weakened enemies
	}

	EyjafjallaStaff: {
		DisplayName: Volcano Staff [Eyjafjalla]
		Tooltip: Fires three molten bolts in a burst, burning enemies on hit
	}
}

Skills: {
	NightmareStaff: {
		1: {
			Label: Drain Soul
			Desc: For 20 seconds: +15% damage; hits release healing wisps that return to you
		}

		2: {
			Label: Night Phantom
			Desc: Automatic: mark up to 3 nearby enemies for 7 seconds, dealing additional damage based on movement; never changes boss behavior
		}
	}

	AbsintheStaff: {
		1: {
			Label: Enforcement Mode
			Desc: Automatic warm-up: +80% damage; prioritizes lowest remaining life percentage, lasting until switching weapons or death
		}

		2: {
			Label: Ultimatum
			Desc: For 20 seconds: four-shot bursts against enemies at or below 50% life; each shot deals 62% damage
		}
	}

	EyjafjallaStaff: {
		1: {
			Label: Duetto
			Desc: For 25 seconds: +60% attack speed; the second and later activations while continuously held also grant +50% damage
		}

		2: {
			Label: Ignition
			Desc: Automatically stores up to 3 charges: next hit deals 310% damage, splashes half its damage to nearby targets and reduces the primary target's Arts resistance by 25%
		}

		3: {
			Label: Volcano
			Desc: For 15 seconds: greatly reduced attack interval, lava deals 150% damage, seeks up to 6 targets and explodes in a small area
		}
	}
}

Buffs: {
	NightmareFetter: {
		DisplayName: Nightmare Fetter
		Description: Dreams slow your movement
	}

	EyjafjallaScorch: {
		DisplayName: Ignition Scorch
		Description: Arts resistance reduced by 25%
	}

	FrostDroneChill: {
	}
}

