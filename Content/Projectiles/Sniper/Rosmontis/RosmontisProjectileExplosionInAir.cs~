using Microsoft.Xna.Framework;
using Terraria;
using Microsoft.Xna.Framework;
using Microsoft.Xna.Framework.Graphics;
using System;
using Terraria;
using Terraria.GameContent;
using Terraria.ModLoader;

namespace ArknightsMod.Content.Projectiles.Sniper.Rosmontis;

public class RosmontisProjectileExplosionInAir : ModProjectile
{
	private const int CircleSegments = 32;
	private BasicEffect circleEffect;

	public void DrawCirclePrimitive(Vector2 center, float radius, Color color)
	{
		DrawRadialPrimitive(center, radius, 0f, MathHelper.TwoPi, color);
	}

	private void DrawRadialPrimitive(Vector2 center, float radius, float startAngle, float angleRange, Color color)
	{
		if (radius <= 0f || angleRange <= 0f)
			return;

		int segments = Math.Max(2, (int)MathF.Round(CircleSegments * angleRange / MathHelper.TwoPi));
		VertexPositionColorTexture[] vertices = new VertexPositionColorTexture[segments * 3];
		Vector2 screenCenter = center - Main.screenPosition;
		for (int i = 0; i < segments; i++) {
			float angle0 = startAngle + angleRange * i / segments;
			float angle1 = startAngle + angleRange * (i + 1) / segments;
			Vector2 edge0 = screenCenter + new Vector2(MathF.Cos(angle0), MathF.Sin(angle0)) * radius;
			Vector2 edge1 = screenCenter + new Vector2(MathF.Cos(angle1), MathF.Sin(angle1)) * radius;
			vertices[i * 3] = new(screenCenter.ToVector3(), color, Vector2.Zero);
			float edgeValue0 = i / (float)segments;
			float edgeValue1 = (i + 1) / (float)segments;
			vertices[i * 3 + 1] = new(edge0.ToVector3(), color, new Vector2(edgeValue0, 1f));
			vertices[i * 3 + 2] = new(edge1.ToVector3(), color, new Vector2(edgeValue1, 1f));
		}

		GraphicsDevice device = Main.graphics.GraphicsDevice;
		circleEffect ??= new BasicEffect(device) {
			TextureEnabled = true,
			VertexColorEnabled = true,
			World = Matrix.Identity,
			View = Matrix.Identity,
			Projection = Matrix.CreateOrthographicOffCenter(0f, Main.screenWidth, Main.screenHeight, 0f, 0f, 1f)
		};
		circleEffect.Texture = TextureAssets.Projectile[Type].Value;
		Main.spriteBatch.End();
		try {
			foreach (EffectPass pass in circleEffect.CurrentTechnique.Passes) {
				pass.Apply();
				device.DrawUserPrimitives(PrimitiveType.TriangleList, vertices, 0, segments);
			}
		}
		finally {
			Main.spriteBatch.Begin(SpriteSortMode.Deferred, BlendState.AlphaBlend, Main.DefaultSamplerState,
				DepthStencilState.None, RasterizerState.CullNone, null, Main.GameViewMatrix.TransformationMatrix);
		}
	}

	/// <summary>
	/// 检测圆形碰撞箱与矩形是否相交。圆心和矩形使用世界坐标，
	/// 半径使用世界单位。
	/// </summary>
	public static bool CheckCircleRectangleCollision(
		Vector2 center, float radius, Rectangle rectangle)
	{
		if (radius < 0f || rectangle.Width < 0 || rectangle.Height < 0)
			return false;

		float closestX = MathHelper.Clamp(center.X, rectangle.Left, rectangle.Right);
		float closestY = MathHelper.Clamp(center.Y, rectangle.Top, rectangle.Bottom);
		Vector2 delta = new Vector2(closestX, closestY) - center;
		return delta.LengthSquared() <= radius * radius;
	}

	private float MaxTime => 30f;

	public override void SetDefaults() {

		Projectile.width = 160;
		Projectile.height = 160;
		Projectile.DamageType = DamageClass.Ranged;
		Projectile.friendly = true;
		Projectile.hostile = false;
		Projectile.ignoreWater = true;
		Projectile.timeLeft = 60;
		Projectile.extraUpdates = 1;
		Projectile.tileCollide = false;
		Projectile.penetrate = -1;
		Projectile.usesLocalNPCImmunity = true;
		Projectile.localNPCHitCooldown = -1;
	}

	public override string Texture => "ArknightsMod/Content/Projectiles/Sniper/Rosmontis/RosmontisProjectileBase";

	public override bool? CanHitNPC(NPC target) {
		float progress = (MaxTime -Projectile.timeLeft) / MaxTime;
		float radius = Projectile.width / 2f * Projectile.scale;
		radius = MathHelper.Clamp(radius * progress,radius/4f,radius);
		if (CheckCircleRectangleCollision(Projectile.Center,radius,target.targetRect)) {
			return true;
		}
		else {
			return false;
		}

		return null;
	}

	public override bool PreDraw(Player player, ref Color lightColor) {
		DrawCirclePrimitive
		return false;
	}
}
