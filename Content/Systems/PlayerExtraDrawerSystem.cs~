using Microsoft.Xna.Framework.Graphics;
using System.Collections.Generic;
using Terraria;
using Terraria.Graphics;
using Terraria.Graphics.Renderers;
using Terraria.ModLoader;

namespace ArknightsMod.Content.Systems
{
	public interface IPlayerExtraDrawer
	{
		void Update();
		void OnPrePlayerDraw();

		void OnPrePlayerDrawPrimitive();
		void OnPostPlayerDraw();

		void OnPostPlayerDrawPrimitive();
	}

	public class PlayerExtraDrawerHandle
	{
		internal readonly IPlayerExtraDrawer drawer;
		internal readonly Player player;

		internal PlayerExtraDrawerHandle(IPlayerExtraDrawer drawer, Player player)
		{
			this.drawer = drawer;
			this.player = player;
		}
	}

	public class PlayerExtraDrawerHandle<T> : PlayerExtraDrawerHandle
		where T : IPlayerExtraDrawer
	{
		public T value;

		internal PlayerExtraDrawerHandle(T value, Player player)
			: base(value, player)
		{
			this.value = value;
		}
	}

	public class PlayerExtraDrawerSystem : ModSystem
	{
		private readonly Dictionary<Player, HashSet<PlayerExtraDrawerHandle>> extraDrawers = new();

		public override void OnModLoad()
		{
			if (Main.dedServ)
				return;

			On_LegacyPlayerRenderer.DrawPlayerFull += DrawPlayerFull;
		}

		public override void Unload()
		{
			if (!Main.dedServ)
				On_LegacyPlayerRenderer.DrawPlayerFull -= DrawPlayerFull;

			extraDrawers.Clear();
		}

		public override void PostUpdatePlayers()
		{
			foreach (HashSet<PlayerExtraDrawerHandle> handles in extraDrawers.Values)
			{
				foreach (PlayerExtraDrawerHandle handle in handles)
					handle.drawer.Update();
			}
		}

		public PlayerExtraDrawerHandle RegisterExtraDrawer(IPlayerExtraDrawer drawer, Player player)
		{
			PlayerExtraDrawerHandle handle = new(drawer, player);
			GetOrCreateHandles(player).Add(handle);
			return handle;
		}

		public PlayerExtraDrawerHandle<T> RegisterExtraDrawer<T>(T drawer, Player player)
			where T : IPlayerExtraDrawer
		{
			PlayerExtraDrawerHandle<T> handle = new(drawer, player);
			GetOrCreateHandles(player).Add(handle);
			return handle;
		}

		public void UnRegisterDrawer(PlayerExtraDrawerHandle handle)
		{
			if (handle == null || !extraDrawers.TryGetValue(handle.player, out HashSet<PlayerExtraDrawerHandle> handles))
				return;

			handles.Remove(handle);
			if (handles.Count == 0)
				extraDrawers.Remove(handle.player);
		}

		private HashSet<PlayerExtraDrawerHandle> GetOrCreateHandles(Player player)
		{
			if (!extraDrawers.TryGetValue(player, out HashSet<PlayerExtraDrawerHandle> handles))
				extraDrawers[player] = handles = new HashSet<PlayerExtraDrawerHandle>();

			return handles;
		}

		private static void DrawPlayerFull(
			On_LegacyPlayerRenderer.orig_DrawPlayerFull orig,
			LegacyPlayerRenderer self,
			Camera camera,
			Player drawPlayer)
		{
			PlayerExtraDrawerSystem system = ModContent.GetInstance<PlayerExtraDrawerSystem>();

			system.InvokeDrawers(drawPlayer, preDraw: true);



			orig(self, camera, drawPlayer);
			system.InvokeDrawers(drawPlayer, preDraw: false);
		}

		private void InvokeDrawers(Player player, bool preDraw)
		{
			if (!extraDrawers.TryGetValue(player, out HashSet<PlayerExtraDrawerHandle> handles))
				return;

			foreach (PlayerExtraDrawerHandle handle in handles)
			{
				Main.spriteBatch.Begin(
					SpriteSortMode.Deferred,
					BlendState.AlphaBlend,
					Main.DefaultSamplerState,
					DepthStencilState.None,
					Main.Rasterizer,
					null,
					Main.GameViewMatrix.TransformationMatrix);

				if (preDraw)
					handle.drawer.OnPrePlayerDraw();
				else
					handle.drawer.OnPostPlayerDraw();

				Main.spriteBatch.End();

				if (preDraw)
					handle.drawer.OnPostPlayerDrawPrimitive();
				else
					handle.drawer.OnPrePlayerDrawPrimitive();
			}
		}
	}
}
